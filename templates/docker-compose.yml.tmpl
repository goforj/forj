networks:
  backend:
    driver: bridge

volumes:
  noop:
    driver: local
{{- if .Resources.DatabaseMySQL }}
  mariadb:
    driver: local
{{ end }}
{{- if .Resources.DatabasePostgres }}
  postgres:
    driver: local
{{ end }}
{{- if .Components.Docker }}
{{ template "developer-service-catalog-volumes" . -}}
{{ end }}

services:

{{- if .Resources.DatabaseMySQL }}
  mysql:
    restart: unless-stopped
    build:
      context: ./containers/mariadb
      args:
        - INNODB_BUFFER_POOL_SIZE=${INNODB_BUFFER_POOL_SIZE:-512MB}
    ports:
      - ${IP_ADDRESS:-127.0.0.1}:${DB_MYSQL_PORT:-${DB_PORT:-3306}}:3306
    volumes:
      - mariadb:/var/lib/mysql
    environment:
      - MARIADB_DATABASE=${DB_DATABASE}
      - MARIADB_USER=${DB_USERNAME}
      - MARIADB_PASSWORD=${DB_PASSWORD}
      - MARIADB_ROOT_PASSWORD=${DB_ROOT_PASSWORD}
      - MARIADB_ALLOW_EMPTY_PASSWORD=NO
      - MARIADB_AUTO_UPGRADE=1
      - TZ=${TZ:-UTC}
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks:
      - backend
{{ end }}

{{- if .Resources.DatabasePostgres }}
  postgres:
    restart: unless-stopped
    image: postgres:16
    ports:
      - ${IP_ADDRESS:-127.0.0.1}:${DB_POSTGRES_PORT:-${DB_PORT:-5432}}:5432
    volumes:
      - postgres:/var/lib/postgresql/data
    environment:
      - POSTGRES_DB=${DB_DATABASE}
      - POSTGRES_USER=${DB_USERNAME}
      - POSTGRES_PASSWORD=${DB_PASSWORD}
      - TZ=${TZ:-UTC}
    networks:
      - backend
{{ end }}

{{- if .Components.Docker }}
  # These catalog services remain dormant until COMPOSE_PROFILES selects them.
{{ template "developer-service-catalog-services" . -}}
{{ end }}
