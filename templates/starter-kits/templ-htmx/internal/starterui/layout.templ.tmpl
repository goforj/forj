		.dark .mini-sidebar a, .dark .command-row, .dark .sheet-preview div, .dark .menu-preview button { color: var(--muted-foreground); }
		.dark .mini-sidebar .active, .dark .command-row:hover, .dark .menu-preview button:hover { background: var(--accent); color: var(--accent-foreground); }
		.mini-sidebar .child { margin-left: 1.5rem; }
		.media-tile { aspect-ratio: 16 / 9; background: linear-gradient(135deg, hsl(0 0% 8%), hsl(0 0% 13%)); border-radius: .75rem; color: #fff; display: grid; font-size: .875rem; font-weight: 500; min-height: 0; place-items: center; }
		.chart-canvas { display: block; height: 12rem; width: 100%; }
