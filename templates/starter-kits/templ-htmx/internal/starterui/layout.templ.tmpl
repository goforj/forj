			.segmented { align-items: center; background: var(--muted); border: 1px solid var(--border); border-radius: var(--radius); display: inline-flex; gap: .25rem; padding: .25rem; width: fit-content; }
			.segmented button, .segmented span { border: 0; border-radius: .375rem; display: inline-flex; font-size: .875rem; min-height: 2rem; padding: .375rem .75rem; }
			.segmented button { background: transparent; color: var(--muted-foreground); cursor: pointer; }
			.segmented button[data-active="true"], .segmented .active { background: var(--background); color: var(--foreground); box-shadow: 0 1px 2px rgba(0,0,0,.06); }
			.segmented button:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
			.dark .segmented { background: var(--muted); border-color: var(--border); }
			.dark .segmented button[data-active="true"], .dark .segmented .active { background: var(--background); color: var(--foreground); }
			.quantity-control { align-items: center; display: inline-flex; gap: .5rem; }
			.quantity-control input { background: transparent; border: 0; box-shadow: none; color: var(--foreground); font-size: .875rem; font-weight: 500; height: 2.25rem; padding: 0; text-align: center; width: 2.5rem; }
			.resizable-preview { --resize-left: 46%; border: 1px solid var(--border); border-radius: calc(var(--radius) + .25rem); display: grid; gap: 0; grid-template-columns: 1fr; overflow: hidden; }
			.resizable-preview.is-resizing { cursor: col-resize; user-select: none; }
			.resize-handle { background: var(--border); cursor: col-resize; display: none; position: relative; touch-action: none; }
			.resize-handle::after { background: var(--muted-foreground); border-radius: 999px; content: ""; height: 2.25rem; left: 50%; opacity: .55; position: absolute; top: 50%; transform: translate(-50%, -50%); width: 2px; }
			.resize-handle:hover::after, .resize-handle:focus-visible::after, .resizable-preview.is-resizing .resize-handle::after { background: var(--foreground); opacity: .9; }
			.resize-handle:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; z-index: 1; }
			.dark .resizable-preview { border-color: var(--border); }
			.dark .resize-handle { background: var(--border); }
				.scroll-panel { min-height: 0; overflow: visible; padding: .75rem; }
				.scroll-panel > p { margin-bottom: .75rem; }
				.activity-scroll { overflow: visible; padding-bottom: .25rem; }
				.carousel-preview { display: grid; gap: .75rem; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); }
			@media (min-width: 1440px) { .resizable-preview { grid-template-columns: minmax(20rem, var(--resize-left)) 6px minmax(20rem, 1fr); min-height: 24rem; } .resize-handle { display: block; } }
			.context-surface { align-items: center; background: color-mix(in oklab, var(--muted) 55%, transparent); border: 1px dashed var(--border); border-radius: calc(var(--radius) + .25rem); color: var(--muted-foreground); display: flex; justify-content: center; min-height: 10rem; padding: 1.5rem; text-align: center; }
			.context-surface:focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; }
			.dark .context-surface { background: color-mix(in oklab, var(--muted) 55%, transparent); border-color: var(--border); color: var(--muted-foreground); }
			.dark .context-surface:focus-visible { outline-color: var(--ring); }
			.demo-menu { background: var(--popover); border: 1px solid var(--border); border-radius: calc(var(--radius) - .125rem); box-shadow: 0 8px 24px rgba(0,0,0,.16); color: var(--popover-foreground); display: grid; max-height: min(28rem, calc(100vh - 2rem)); min-width: 8rem; overflow-x: hidden; overflow-y: auto; padding: .25rem; z-index: 70; }
			.demo-menu-item { align-items: center; background: transparent; border: 0; border-radius: calc(var(--radius) - .25rem); color: var(--popover-foreground); cursor: default; display: flex; font-size: .875rem; gap: .5rem; line-height: 1.25rem; min-height: 2rem; outline: none; padding: .375rem .5rem; position: relative; text-align: left; user-select: none; width: 100%; }
			.demo-menu-item:hover, .demo-menu-item:focus-visible { background: var(--accent); color: var(--accent-foreground); outline: none; }
			.demo-menu-item .icon { color: var(--muted-foreground); height: 1rem; width: 1rem; }
			.demo-menu-item:hover .icon, .demo-menu-item:focus-visible .icon { color: currentColor; }
			.demo-menu-item.danger-action { color: var(--destructive); }
			.demo-menu-item.danger-action:hover, .demo-menu-item.danger-action:focus-visible { background: color-mix(in oklab, var(--destructive) 10%, transparent); color: var(--destructive); }
			.context-menu-panel { background: var(--popover); border: 1px solid var(--border); border-radius: calc(var(--radius) - .125rem); box-shadow: 0 8px 24px rgba(0,0,0,.16); display: grid; min-width: 13rem; padding: .25rem; position: fixed; z-index: 70; }
			.context-menu-panel[hidden] { display: none; }
			.dark .demo-menu, .dark .context-menu-panel { background: var(--popover); border-color: var(--border); color: var(--popover-foreground); }
			.dark .demo-menu-item { color: var(--popover-foreground); }
			.dark .demo-menu-item:hover, .dark .demo-menu-item:focus-visible { background: var(--accent); color: var(--accent-foreground); }
			.dark .demo-menu-item.danger-action { color: var(--destructive); }
