package starterui

templ baseHead(title string) {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
	<title>{ title } - GoForj</title>
	<link rel="icon" href="/goforj-logo.png" type="image/png"/>
	<link rel="apple-touch-icon" href="/goforj-logo.png"/>
	<script>
		(() => {
			try {
				if (localStorage.getItem("sidebar-collapsed") === "true") {
					document.documentElement.classList.add("sidebar-collapsed");
				}
			} catch {}
		})();
	</script>
	<link rel="stylesheet" href="/app.css"/>
	<style>
		:root {
			--sidebar-width: 18rem;
			--sidebar-width-icon: 3rem;
			--header-height: 3rem;
			font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
			color: var(--foreground);
			background: var(--background);
		}
		* { box-sizing: border-box; }
		body { margin: 0; min-width: 320px; background: var(--background); color: var(--foreground); -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
		.dark body { background: var(--background); color: var(--foreground); }
		a { color: inherit; text-decoration: none; }
		button, input, select, textarea { font: inherit; }
		button { cursor: pointer; }
		.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
		.icon { display: inline-block; flex-shrink: 0; height: 1rem; width: 1rem; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; fill: none; }
		.icon-tile .icon { height: 1.25rem; width: 1.25rem; }
		.spin { animation: spin .9s linear infinite; }
		@keyframes spin { to { transform: rotate(360deg); } }
			.gf-shell { min-height: 100vh; background: var(--background); color: var(--foreground); overflow-anchor: none; }
			.dark .gf-shell { background: var(--background); color: var(--foreground); }
			.gf-main { min-height: 100vh; min-width: 0; }
			.brand, .gf-header { align-items: center; display: flex; gap: .5rem; }
			.app-sidebar nav { border-color: var(--sidebar-border); }
			.team-switcher { align-items: center; border-radius: var(--radius); color: var(--sidebar-foreground); display: flex; flex-shrink: 0; gap: .75rem; margin: .5rem; min-height: 3rem; min-width: 0; overflow: hidden; padding: .25rem; width: calc(100% - 1rem); }
			.team-switcher:hover { background: var(--sidebar-accent); color: var(--sidebar-accent-foreground); }
			.team-switcher-mark { display: grid; flex: 0 0 2.5rem; height: 2.5rem; place-items: center; width: 2.5rem; }
			.team-switcher-mark img { display: block; height: 100%; object-fit: contain; width: 100%; }
			.team-switcher-label { font-size: .875rem; font-weight: 600; letter-spacing: 0; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.sidebar-logo { height: 2rem; width: 2rem; object-fit: contain; }
			.sidebar-brand { min-width: 0; text-align: left; }
			.sidebar-brand span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.sidebar-kbd { margin-left: auto; }
			.sidebar-avatar { height: 2rem; width: 2rem; }
			.app-sidebar nav ul li > button { align-items: center; background: transparent; border: 0; border-radius: var(--radius); color: var(--sidebar-foreground); display: flex; gap: .5rem; min-height: 2rem; padding: .5rem .625rem; text-align: left; width: 100%; }
			.app-sidebar nav ul li > button:hover { background: var(--sidebar-accent); color: var(--sidebar-accent-foreground); }
			.app-sidebar nav > footer .dropdown-menu { display: flex; min-width: 0; width: 100%; }
			.app-user-trigger { align-items: center; background: transparent; border: 0; border-radius: var(--radius); color: var(--sidebar-foreground); display: flex; gap: .75rem; min-height: 3rem; min-width: 0; overflow: hidden; padding: .5rem; text-align: left; width: 100%; }
			.app-user-trigger:hover, .app-user-trigger[aria-expanded="true"] { background: var(--sidebar-accent); color: var(--sidebar-accent-foreground); }
			.app-user-avatar { align-items: center; background: var(--sidebar-accent); border-radius: var(--radius); color: var(--sidebar-accent-foreground); display: inline-flex; flex: 0 0 2rem; font-size: .75rem; font-weight: 600; height: 2rem; justify-content: center; width: 2rem; }
			.app-user-text { display: grid; flex: 1 1 auto; line-height: 1.2; min-width: 0; }
			.app-user-text span { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
			.app-user-email { color: color-mix(in oklab, var(--sidebar-foreground) 70%, transparent); font-size: .75rem; font-weight: 400; }
			.app-user-chevron { flex: 0 0 auto; margin-left: auto; }
			.app-sidebar [data-popover] { color: var(--popover-foreground); }
			.app-sidebar form[role="none"] { margin: 0; }
		@media (min-width: 768px) {
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) { --sidebar-width: var(--sidebar-width-icon); }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar h3,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .sidebar-text,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .sidebar-brand,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .team-switcher-label,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .app-user-text,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .app-user-chevron,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .sidebar-kbd,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav ul li > a > span,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav ul li > button > span,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav ul ul,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav > footer .dropdown-menu > button > svg { display: none; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav > header,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav > footer,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav > section > [role="group"] { align-items: center; padding-left: .5rem; padding-right: .5rem; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav ul li > a,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav ul li > button,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav > header > a,
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar nav > footer .dropdown-menu > button { height: 2rem; justify-content: center; min-height: 2rem; padding: 0; width: 2rem; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .app-user-trigger { height: 2rem; justify-content: center; min-height: 2rem; padding: 0; width: 2rem; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .app-user-avatar { border-radius: 999px; flex-basis: 1.75rem; height: 1.75rem; width: 1.75rem; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .team-switcher { height: 2.5rem; min-height: 2.5rem; margin: 0; padding: 0; width: 2.5rem; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .team-switcher-mark { flex-basis: 2rem; height: 2rem; width: 2rem; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .sidebar-logo { height: 1.625rem; width: 1.625rem; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar .sidebar-avatar { border-radius: 999px; flex: 0 0 1.75rem; height: 1.75rem; line-height: 1; width: 1.75rem; }
				:is(.gf-shell.sidebar-collapsed, .sidebar-collapsed .gf-shell) .app-sidebar [data-popover] { min-width: 14rem; }
			}
			.brand img { height: 2rem; width: 2rem; border-radius: .5rem; }
			.brand-name { font-size: .875rem; font-weight: 650; }
			.muted, .brand-muted { color: var(--muted-foreground); }
			.dark .muted, .dark .brand-muted { color: var(--muted-foreground); }
			.brand-muted { font-size: .75rem; }
		.icon-button { align-items: center; background: var(--background); border: 1px solid var(--border); border-radius: calc(var(--radius) - .125rem); display: inline-flex; height: 2.25rem; justify-content: center; width: 2.25rem; }
		.gf-header { border-bottom: 1px solid var(--border); height: var(--header-height); padding: 0 1rem; }
		.dark .gf-header { border-bottom-color: var(--border); }
		@media (min-width: 1024px) { .gf-header { padding: 0 1.5rem; } }
		.sidebar-trigger { align-items: center; background: transparent; border: 0; border-radius: calc(var(--radius) - .125rem); color: var(--foreground); display: inline-flex; height: 2rem; justify-content: center; margin-left: -.25rem; width: 2rem; }
		.sidebar-trigger:hover { background: var(--accent); color: var(--accent-foreground); }
		.dark .sidebar-trigger { color: var(--foreground); }
		.dark .sidebar-trigger:hover { background: var(--accent); }
		.separator-vertical { background: var(--border); height: 1rem; margin: 0 .5rem; width: 1px; }
		.dark .separator-vertical { background: var(--border); }
		.breadcrumb-list { align-items: center; color: var(--muted-foreground); display: flex; font-size: .875rem; gap: .5rem; }
		.breadcrumb-page { align-items: center; color: var(--foreground); display: inline-flex; gap: .375rem; font-weight: 500; }
		.dark .breadcrumb-page { color: var(--foreground); }
		.gf-content, .page-stack { display: grid; gap: 1rem; }
		.gf-content { background: linear-gradient(180deg, color-mix(in oklab, var(--background) 84%, transparent), var(--background)); padding: 1rem; }
		.dark .gf-content { background: var(--background); }
		@media (min-width: 1024px) { .gf-content { padding: 1rem; } }
		.card, .hero-card { border: 1px solid var(--border); border-radius: calc(var(--radius) + .25rem); background: var(--card); color: var(--card-foreground); padding: 1.5rem; box-shadow: 0 1px 2px rgba(0,0,0,.05); }
		.dark .card, .dark .hero-card { background: var(--card); border-color: var(--border); color: var(--card-foreground); }
		.hero-card { display: grid; gap: 1.5rem; overflow: hidden; background: var(--card); }
		.dark .hero-card { background: var(--card); box-shadow: 0 1px 2px rgba(0,0,0,.12); }
		@media (min-width: 768px) { .hero-card { padding: 2rem; } }
		.hero-card h1 { max-width: 52rem; margin: 0; font-size: clamp(1.875rem, 3vw, 2.5rem); font-weight: 600; line-height: 1.08; letter-spacing: 0; }
		.hero-card p { color: var(--muted-foreground); font-size: 1rem; line-height: 1.65; margin: 0; max-width: 42rem; }
		.card p { color: var(--muted-foreground); font-size: .875rem; line-height: 1.6; margin: 0; }
		.dark .card p, .dark .hero-card p { color: var(--muted-foreground); }
		.card { align-content: start; display: grid; gap: 1.5rem; }
		.card h1, .card h2, .card p { margin: 0; }
		.card h2 { font-size: 1.25rem; font-weight: 650; }
		.card-header { display: grid; gap: .5rem; }
		.card-content { display: grid; gap: 1rem; }
		.card-actions { align-items: center; display: flex; flex-wrap: wrap; gap: .75rem; }
		.feature-card { gap: .75rem; }
		.feature-card h2 { font-size: 1rem; }
		.muted-list { color: var(--muted-foreground); display: grid; font-size: .875rem; gap: .5rem; line-height: 1.6; list-style: none; margin: 0; padding-left: 0; }
		.grid { display: grid; gap: 1rem; }
		.overlay-stack, .toolbar-grid { display: grid; gap: 1rem; }
		.section-stack { columns: 1; column-gap: 1rem; }
		.section-stack > * { break-inside: avoid-column; margin: 0 0 1rem; page-break-inside: avoid; }
		.section-wide { column-span: all; }
		.split { align-items: start; }
		@media (min-width: 768px) { .grid-2 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .grid-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } .grid-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } .split { grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); } .toolbar-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .toolbar-grid > .demo-card:last-child { grid-column: 1 / -1; } }
		@media (min-width: 1024px) { .section-stack { column-count: 2; } }
		@media (min-width: 1280px) { .grid-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
		.badge-row, .tag-row, .table-tools { align-items: center; display: flex; flex-wrap: wrap; gap: .5rem; }
		.component-token-list { display: flex; flex-wrap: wrap; gap: .5rem; }
		.component-token { align-items: center; display: inline-flex; gap: .35rem; }
		.component-token code { color: var(--muted-foreground); font-size: .7rem; font-weight: 500; }
		.icon-tile { display: grid; height: 2.5rem; width: 2.5rem; place-items: center; border-radius: calc(var(--radius) + .125rem); background: var(--muted); color: var(--foreground); }
		.dark .icon-tile { background: var(--muted); color: var(--foreground); }
		.step-card { border: 1px solid var(--border); border-radius: var(--radius); display: grid; gap: .35rem; padding: 1rem; }
		.dark .step-card { border-color: var(--border); }
		.step-card.compact { gap: .5rem; }
		.step-card.compact span { display: none; }
		.step-card span { background: var(--muted); border-radius: 999px; display: grid; font-size: .75rem; font-weight: 700; height: 1.75rem; place-items: center; width: 1.75rem; }
		.step-grid { display: grid; gap: 1rem; }
		@media (min-width: 640px) { .step-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
		.notice, .alert-inline, .success-panel, .info-panel, .error { align-items: center; border-radius: .5rem; display: flex; gap: .875rem; padding: 1rem; }
		.notice { border: 1px dashed var(--border); background: color-mix(in oklab, var(--muted) 58%, transparent); color: var(--muted-foreground); font-size: .875rem; justify-content: space-between; }
		.dark .notice { background: color-mix(in oklab, var(--muted) 58%, transparent); border-color: var(--border); color: var(--muted-foreground); }
		.notice a:not([class*="btn"]) { color: var(--foreground); font-weight: 500; text-decoration: underline; text-underline-offset: 4px; }
		.alert-inline, .info-panel { border: 1px solid var(--border); background: color-mix(in oklab, var(--muted) 58%, transparent); }
		.alert-inline { align-items: flex-start; }
		.alert-inline > div { display: grid; gap: .25rem; }
		.source-callout { align-items: flex-start; background: var(--card); border: 1px solid var(--border); border-radius: calc(var(--radius) + .25rem); display: grid; gap: .875rem; grid-template-columns: auto minmax(0, 1fr); padding: 1rem; box-shadow: 0 1px 2px rgba(0,0,0,.04); }
		.source-callout-icon { align-items: center; background: var(--muted); border-radius: var(--radius); color: var(--foreground); display: inline-flex; height: 2.25rem; justify-content: center; width: 2.25rem; }
		.source-callout-icon .icon { height: 1.125rem; width: 1.125rem; }
		.source-callout > div { display: grid; gap: .25rem; min-width: 0; }
		.source-callout p { color: var(--muted-foreground); font-size: .875rem; line-height: 1.6; margin: 0; }
		.dark .source-callout { background: var(--card); border-color: var(--border); }
		.dark .source-callout-icon { background: var(--muted); color: var(--foreground); }
		.dark .source-callout p { color: var(--muted-foreground); }
		.success-panel { border: 1px solid rgba(22,163,74,.28); background: rgba(22,163,74,.08); color: #15803d; }
		.error { border: 1px solid rgba(220,38,38,.3); background: rgba(220,38,38,.08); color: #b91c1c; font-size: .875rem; }
		.field, .form, .settings-form, .control-list { display: grid; gap: 1rem; }
		.field { gap: .375rem; font-size: .875rem; font-weight: 500; text-align: left; }
		.field input, .field select, .field textarea, .table-tools input { width: 100%; }
		.field textarea { min-height: 6rem; resize: vertical; }
		.gf-input-group { align-items: center; background: color-mix(in oklab, var(--input) 45%, transparent); border: 1px solid var(--input); border-radius: var(--radius); display: flex; gap: .5rem; min-height: 2.5rem; padding: 0 .75rem; transition: border-color .15s ease, box-shadow .15s ease; width: 100%; }
		.gf-input-group:focus-within { border-color: var(--ring); box-shadow: 0 0 0 3px color-mix(in oklab, var(--ring) 24%, transparent); }
		.gf-input-group-pill { border-radius: 999px; }
		.gf-input-group-stack { align-items: stretch; flex-direction: column; gap: 0; overflow: hidden; padding: 0; }
		.gf-input-group input, .gf-input-group textarea { background: transparent; border: 0; box-shadow: none; color: var(--foreground); flex: 1; min-width: 0; outline: 0; width: 100%; }
		.gf-input-group input { min-height: 2.375rem; padding: .5rem 0; }
		.gf-input-group textarea { display: block; min-height: 6rem; padding: .75rem; resize: vertical; }
		.gf-input-addon { align-items: center; color: var(--muted-foreground); display: inline-flex; flex: 0 0 auto; gap: .5rem; min-height: 2.375rem; white-space: nowrap; }
		.gf-input-addon .icon { height: 1rem; width: 1rem; }
		.gf-input-addon-end { margin-left: auto; }
		.gf-input-toolbar { align-items: center; display: flex; flex-wrap: wrap; gap: .5rem; padding: .5rem .75rem; }
		.gf-input-toolbar-top { border-bottom: 1px solid var(--border); }
		.gf-input-toolbar-bottom { border-top: 1px solid var(--border); }
		.gf-input-toolbar-spacer { margin-left: auto; }
		.gf-handoff { border: 1px solid var(--border); border-radius: calc(var(--radius) + .25rem); display: grid; gap: 1rem; padding: 1rem; }
		.gf-handoff-heading { display: grid; gap: .25rem; }
		.gf-handoff-heading p { color: var(--muted-foreground); font-size: .875rem; line-height: 1.6; margin: 0; }
		.gf-verified-mark { align-items: center; background: var(--primary); border-radius: 999px; color: var(--primary-foreground); display: inline-flex; height: 1.5rem; justify-content: center; width: 1.5rem; }
		.gf-verified-mark .icon { height: 1rem; width: 1rem; }
		.dark .gf-input-group { background: color-mix(in oklab, var(--input) 58%, transparent); border-color: var(--input); }
		.password-field { position: relative; }
		.password-field input { padding-right: 4rem; }
		.password-field button { background: var(--muted); border: 1px solid var(--border); border-radius: calc(var(--radius) - .125rem); color: var(--muted-foreground); font-size: .625rem; letter-spacing: .12em; padding: .25rem .5rem; position: absolute; right: .5rem; text-transform: uppercase; top: 50%; transform: translateY(-50%); }
		.dark .password-field button { background: var(--muted); border-color: var(--border); color: var(--muted-foreground); }
		.field-link { color: var(--muted-foreground); font-size: .875rem; justify-self: end; }
		.field-link:hover, .auth-signup a:hover { color: var(--foreground); text-decoration: underline; text-underline-offset: 4px; }
		.login { min-height: 100vh; background: var(--background); }
		.dark .login { background: var(--background); color: var(--foreground); }
		.login-main { align-items: center; display: flex; justify-content: center; min-height: 100vh; padding: 1.5rem; }
		.auth-panel { display: flex; flex-direction: column; gap: 2rem; width: min(100%, 24rem); }
		.auth-logo { align-items: center; display: flex; flex-direction: column; gap: .5rem; }
		.auth-logo img { height: 3rem; object-fit: contain; width: 3rem; }
		.form { display: flex; flex-direction: column; gap: 1.5rem; width: 100%; }
		.auth-panel .form h1 { margin: 0; font-size: 1.25rem; font-weight: 500; text-align: center; }
		.form p { color: var(--muted-foreground); font-size: .875rem; line-height: 1.6; margin: .5rem 0 0; }
		.auth-panel .form > div:first-child { text-align: center; }
		.auth-links { display: flex; justify-content: space-between; color: var(--muted-foreground); font-size: .875rem; }
		.auth-signup { color: var(--muted-foreground); font-size: .875rem; text-align: center; }
		.auth-signup a { text-decoration: underline; text-underline-offset: 4px; }
		.settings-page { display: grid; gap: 1.5rem; padding: .5rem 0; }
		.settings-heading { display: grid; gap: .25rem; }
		.settings-heading h1 { font-size: 1.875rem; font-weight: 600; letter-spacing: 0; line-height: 1.2; margin: 0; }
		.settings-heading p, .settings-form p { color: var(--muted-foreground); margin: 0; }
		.settings-shell { display: flex; flex-direction: column; gap: 2rem; }
		@media (min-width: 1024px) { .settings-shell { flex-direction: row; gap: 3rem; } }
		.settings-nav { align-content: start; display: grid; gap: .25rem; width: 100%; }
		@media (min-width: 1024px) { .settings-nav { flex: 0 0 16rem; } }
		.settings-nav a { align-items: center; border-radius: var(--radius); color: var(--muted-foreground); display: flex; gap: .5rem; min-height: 2.25rem; padding: .5rem .75rem; }
		.settings-nav a:hover, .settings-nav .active { background: var(--accent); color: var(--accent-foreground); }
		.settings-panel { flex: 1; max-width: 36rem; min-width: 0; }
		.settings-form h1 { font-size: 1.25rem; font-weight: 600; letter-spacing: 0; line-height: 1.4; margin: 0; }
		.settings-form > div:first-child { display: grid; gap: .25rem; }
		.dark .settings-heading p, .dark .settings-form p { color: var(--muted-foreground); }
		.dark .settings-nav a { color: var(--muted-foreground); }
		.dark .settings-nav a:hover, .dark .settings-nav .active { background: var(--accent); color: var(--accent-foreground); }
		.theme-grid { display: grid; gap: 1rem; }
		@media (min-width: 768px) { .theme-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
