templ shell(data PageData) {
	<!doctype html>
	<html lang="en">
		<head>
			@baseHead(data.Title)
		</head>
				<body>
					@appShell(data) {
						{ children... }
					}
					@appCommandMenu()
					<div id="toaster" class="toaster" aria-live="polite" aria-label="Notifications"></div>
			</body>
		</html>
	}
templ appShell(data PageData) {
	<div class="gf-shell">
		@appSidebar(data)
		<main class="gf-main">
			@appHeader(data)
			@appContent() {
				{ children... }
			}
		</main>
	</div>
}
templ appSidebar(data PageData) {
	<aside id="app-sidebar" class="sidebar app-sidebar" data-side="left" aria-hidden="false">
		<nav aria-label="Sidebar navigation">
			<header>
				@appTeamSwitcher()
			</header>
			<section class="scrollbar">
				@appSidebarNavigation(data)
			</section>
			<footer>
				@appUserMenu(data.User)
			</footer>
		</nav>
	</aside>
}
templ appTeamSwitcher() {
	<a class="team-switcher" href="/" hx-boost="true" hx-target="body" hx-swap="innerHTML show:none">
		<span class="team-switcher-mark">
			<img src="/goforj-logo.png" alt="GoForj Starter Kit"/>
		</span>
		<span class="team-switcher-label">GoForj Starter Kit</span>
	</a>
}
templ appSidebarNavigation(data PageData) {
	<div role="group" aria-labelledby="platform-sidebar-group" hx-boost="true" hx-target="body" hx-swap="innerHTML show:none">
		<h3 id="platform-sidebar-group">Platform</h3>
		<ul>
			<li>
				if data.Title == "Dashboard" {
					<a href="/" aria-current="page">@iconDashboard()<span>Dashboard</span></a>
				} else {
					<a href="/">@iconDashboard()<span>Dashboard</span></a>
				}
			</li>
{{- if .ComponentLibrary }}
			<li>
				if data.Title == "Components Overview" {
					<a href="/components/overview" aria-current="page">@iconBlocks()<span>Components</span></a>
				} else {
					<a href="/components/overview">@iconBlocks()<span>Components</span></a>
				}
				if componentsActive(data.Title) {
					<ul>
						<li>
							if data.Title == "Components Overview" {
								<a href="/components/overview" aria-current="page">Overview</a>
							} else {
								<a href="/components/overview">Overview</a>
							}
						</li>
						<li>
							if data.Title == "Components Forms" {
								<a href="/components/forms" aria-current="page">Forms</a>
							} else {
								<a href="/components/forms">Forms</a>
							}
						</li>
						<li>
							if data.Title == "Components Navigation" {
								<a href="/components/navigation" aria-current="page">Navigation</a>
							} else {
								<a href="/components/navigation">Navigation</a>
							}
						</li>
						<li>
							if data.Title == "Components Overlays" {
								<a href="/components/overlays" aria-current="page">Overlays</a>
							} else {
								<a href="/components/overlays">Overlays</a>
							}
						</li>
						<li>
							if data.Title == "Components Data" {
								<a href="/components/data" aria-current="page">Data</a>
							} else {
								<a href="/components/data">Data</a>
							}
						</li>
					</ul>
				}
			</li>
{{- end }}
		</ul>
	</div>
	<div role="group" aria-labelledby="resources-sidebar-group">
		<h3 id="resources-sidebar-group">Resources</h3>
		<ul>
			<li><a href="https://github.com/goforj/goforj">@iconGithub()<span>Repository</span></a></li>
			<li><a href="https://goforj.dev">@iconBookOpen()<span>Documentation</span></a></li>
		</ul>
	</div>
	<div role="group" aria-labelledby="shortcuts-sidebar-group" class="mt-auto">
		<h3 id="shortcuts-sidebar-group">Shortcuts</h3>
		<ul>
			<li>
				<button type="button" data-gf-open-dialog="gf-command-menu">
					@iconCommand()
					<span>Command Menu</span>
					<kbd class="sidebar-kbd">Ctrl K</kbd>
				</button>
			</li>
		</ul>
	</div>
}
templ appCommandMenu() {
	<dialog id="gf-command-menu" class="command-dialog gf-command-compact" aria-label="Command menu">
		<div class="command">
			<header>
				@iconSearch()
				<input data-gf-autofocus type="text" placeholder="Type a command or search..." autocomplete="off" autocorrect="off" spellcheck="false" aria-autocomplete="list" role="combobox" aria-expanded="true" aria-controls="gf-command-menu-list"/>
			</header>
			<div id="gf-command-menu-list" role="menu" aria-orientation="vertical" data-empty="No results found." class="scrollbar">
				<div role="group" aria-labelledby="gf-command-navigation">
					<span role="heading" id="gf-command-navigation">Navigation</span>
					<a role="menuitem" href="/">@iconDashboard()<span>Dashboard</span><kbd class="ml-auto text-muted-foreground bg-transparent tracking-widest">G D</kbd></a>
{{- if .ComponentLibrary }}
					<a role="menuitem" href="/components/overview">@iconBlocks()<span>Components overview</span><kbd class="ml-auto text-muted-foreground bg-transparent tracking-widest">G C</kbd></a>
					<a role="menuitem" href="/components/forms">@iconWorkflow()<span>Components forms</span></a>
					<a role="menuitem" href="/components/navigation">@iconLayoutTemplate()<span>Components navigation</span></a>
					<a role="menuitem" href="/components/overlays">@iconMousePointerClick()<span>Components overlays</span></a>
					<a role="menuitem" href="/components/data">@iconDatabase()<span>Components data</span></a>
{{- end }}
				</div>
				<hr role="separator"/>
				<div role="group" aria-labelledby="gf-command-settings">
					<span role="heading" id="gf-command-settings">Settings</span>
					<a role="menuitem" href="/settings/profile">@iconSettings()<span>Profile settings</span></a>
					<a role="menuitem" href="/settings/password">@iconShieldCheck()<span>Password settings</span></a>
					<a role="menuitem" href="/settings/appearance">@iconMonitor()<span>Appearance settings</span></a>
				</div>
				<hr role="separator"/>
{{- if and .Components.Auth .Components.HasDatabase }}
				<div role="group" aria-labelledby="gf-command-actions">
					<span role="heading" id="gf-command-actions">Actions</span>
					<form method="post" action="/logout"><button role="menuitem" type="submit">@iconLogOut()<span>Log out</span></button></form>
				</div>
{{- end }}
			</div>
		</div>
	</dialog>
}
templ appUserMenu(user UserData) {
	<div id="app-user-menu" class="dropdown-menu">
		<button id="app-user-menu-trigger" class="app-user-trigger" type="button" aria-label="Open user menu" aria-haspopup="menu" aria-controls="app-user-menu-menu" aria-expanded="false">
			<span class="app-user-avatar">{ userInitials(user.Name) }</span>
			<span class="app-user-text">
				<span class="truncate">{ user.Name }</span>
				<span class="app-user-email">{ user.Email }</span>
			</span>
			<span class="app-user-chevron">@iconChevronsUpDown()</span>
		</button>
		<div id="app-user-menu-popover" data-popover data-side="top" data-align="start" aria-hidden="true" class="min-w-56">
			<div id="app-user-menu-menu" role="menu" aria-label="User menu" aria-labelledby="app-user-menu-trigger">
				<div role="heading">
					<span class="grid leading-tight">
						<span>{ user.Name }</span>
						<span class="text-xs font-normal text-muted-foreground">{ user.Email }</span>
					</span>
				</div>
				<hr role="separator"/>
				<a role="menuitem" href="/settings/profile">@iconSettings()<span>Settings</span></a>
{{- if and .Components.Auth .Components.HasDatabase }}
				<form role="none" method="post" action="/logout">
					<button role="menuitem" type="submit">@iconLogOut()<span>Log out</span></button>
				</form>
{{- end }}
			</div>
		</div>
	</div>
}
templ appHeader(data PageData) {
		<header class="gf-header">
			<button class="sidebar-trigger" type="button" aria-label="Toggle sidebar" data-gf-sidebar-toggle>@iconPanelLeft()</button>
		<span class="separator-vertical" aria-hidden="true"></span>
		<nav class="breadcrumb-list" aria-label="Breadcrumb">
			<span>Application</span>
			@iconChevronRight()
			<span class="breadcrumb-page">{ data.Title }</span>
		</nav>
	</header>
}
templ appContent() {
	<section class="gf-content">
		{ children... }
	</section>
}
templ componentIcon(title string) {
	if title == "Forms" {
		@iconWorkflow()
	} else if title == "Navigation" {
		@iconLayoutTemplate()
	} else if title == "Overlays" {
		@iconMousePointerClick()
	} else if title == "Data" {
		@iconDatabase()
	}
}
