		.preview-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)); }
		.mini-sidebar, .command-box, .dialog-preview, .sheet-preview, .menu-preview, .popover-card { align-content: start; background: color-mix(in oklab, var(--muted) 55%, transparent); border: 1px solid var(--border); border-radius: calc(var(--radius) + .125rem); display: grid; gap: .75rem; padding: 1rem; }
		.dark .mini-sidebar, .dark .command-box, .dark .dialog-preview, .dark .sheet-preview, .dark .menu-preview, .dark .popover-card { background: color-mix(in oklab, var(--muted) 55%, transparent); border-color: var(--border); }
		.mini-sidebar a, .command-row, .sheet-preview div, .menu-preview button { align-items: center; border-radius: var(--radius); color: var(--muted-foreground); display: flex; gap: .75rem; justify-content: space-between; min-height: 2.25rem; padding: .5rem .65rem; text-align: left; }
