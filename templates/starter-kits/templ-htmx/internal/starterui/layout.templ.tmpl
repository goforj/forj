		.dark .otp-row span { border-color: var(--border); }
		.dark .skeleton span { background: var(--muted); }
		.dark .empty-box { border-color: var(--border); }
		.empty-box .empty-icon { background: var(--muted); border-radius: calc(var(--radius) + .125rem); display: grid; height: 2.5rem; place-items: center; width: 2.5rem; }
			.avatar-stack { display: flex; filter: grayscale(1); margin-bottom: .5rem; }
