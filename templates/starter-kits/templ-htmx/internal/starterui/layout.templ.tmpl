			.dark .accordion-row { border-color: var(--border); }
			.gf-drawer { border: 0; border-radius: calc(var(--radius) + .25rem); color: var(--foreground); margin: auto; max-width: min(38rem, calc(100vw - 2rem)); padding: 0; width: 100%; }
			.gf-drawer::backdrop { background: rgba(0,0,0,.45); }
