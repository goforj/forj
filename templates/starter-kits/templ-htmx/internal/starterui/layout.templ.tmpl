			.gf-command-compact.command-dialog .command [role=menu] [role=menuitem] { padding-inline: calc(var(--spacing) * 2); padding-block: calc(var(--spacing) * 1.5); }
			.gf-command-compact.command-dialog .command [role=menu] [role=menuitem] svg:not([class*=size-]) { height: calc(var(--spacing) * 4); width: calc(var(--spacing) * 4); }
