		.item-list { display: grid; gap: .75rem; }
		.item-row { align-items: center; border: 1px solid var(--border); border-radius: var(--radius); display: grid; gap: .75rem; grid-template-columns: auto minmax(0, 1fr) auto; padding: 1rem; }
		.item-row.muted-row { background: color-mix(in oklab, var(--muted) 58%, transparent); border-color: transparent; }
