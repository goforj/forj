type starterUITestAuthFixture struct {
	Service  *auth.Service
	Login    string
	Password string
}

func newStarterUITestAuthFixture(t *testing.T) starterUITestAuthFixture {
	t.Helper()
	t.Setenv("APP_ENV", "local")
	t.Setenv("API_JWT_SECRET_KEY", "starter-ui-test-secret")
	t.Setenv("AUTH_COOKIE_SECURE", "false")
	t.Setenv("DB_DRIVER", "sqlite")
	t.Setenv("DB_DATABASE", filepath.Join(t.TempDir(), "starter-ui-auth.db"))
	if err := env.Load(); err != nil {
		t.Fatalf("load env: %v", err)
	}

{{- if .Components.Metrics }}
	metricsManager := metrics.NewManager()
{{- end }}
	conns := database.NewConnections({{- if .Components.Metrics }}metricsManager, {{- end }}nil)
	t.Cleanup(func() {
		_ = conns.Close(context.Background())
	})
	migrate := migrations.NewMigrateCmd(logger.NewSilentLogger(), conns)
	if err := migrate.Run(); err != nil {
		t.Fatalf("run migrations: %v", err)
	}

	cacheManager, err := caches.NewManager()
	if err != nil {
		t.Fatalf("new cache manager: %v", err)
	}
	sessionCache := cacheManager.Sessions()
	appLogger := logger.NewSilentLogger()
	service := auth.NewService(
		auth.NewUserRepo(conns, sessionCache),
		auth.NewAuthSessionRepo(conns, sessionCache),
{{- if .Components.OAuth }}
		auth.NewAuthIdentityRepo(conns),
		auth.NewOAuthStateRepo(conns),
		auth.NewOAuthProviders(),
{{- end }}
		auth.NewEmailVerificationRepo(conns),
		auth.NewPasswordResetRepo(conns),
		auth.NewLoginAttemptRepo(conns),
		auth.NewLogDelivery(appLogger),
		appLogger,
{{- if .Components.Metrics }}
		metricsManager,
{{- end }}
	)

	login := str.Of(t.Name()).ToLower().ReplaceAll("/", "-").ReplaceAll(" ", "-").String() + "-" + strconv.FormatInt(time.Now().UnixNano(), 10)
	password := "Admin!123"
	if _, err := service.Register(t.Context(), auth.RegisterInput{
		Username:    login,
		DisplayName: "Admin User",
		Email:       login + "@example.com",
		Password:    password,
		Remember:    true,
		UserAgent:   "starter-ui-test",
		IPAddress:   "127.0.0.1",
	}); err != nil {
		t.Fatalf("register user: %v", err)
	}
	return starterUITestAuthFixture{Service: service, Login: login, Password: password}
}

func starterUITestLogin(t *testing.T, fixture starterUITestAuthFixture, controller *Controller) *httptest.ResponseRecorder {
	t.Helper()
	form := url.Values{}
	form.Set("login", fixture.Login)
	form.Set("password", fixture.Password)
	form.Set("remember", "on")
	req := httptest.NewRequest(http.MethodPost, "/login", strings.NewReader(form.Encode()))
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")
	rec := httptest.NewRecorder()
	ctx := webtest.NewContext(req, rec, "/login", nil)

	if err := controller.Login(ctx); err != nil {
		t.Fatalf("login: %v", err)
	}
	return rec
}

func TestStarterUILoginFlowIntegration(t *testing.T) {
	fixture := newStarterUITestAuthFixture(t)
	controller := NewController(fixture.Service)
	rec := starterUITestLogin(t, fixture, controller)
	if rec.Code != http.StatusSeeOther {
		t.Fatalf("login status = %d, want %d", rec.Code, http.StatusSeeOther)
	}
	if location := rec.Header().Get("Location"); location != "/" {
		t.Fatalf("login redirect = %q, want /", location)
	}
	if len(rec.Result().Cookies()) == 0 {
		t.Fatal("expected login to set auth cookies")
	}

	req := httptest.NewRequest(http.MethodGet, "/", nil)
	for _, cookie := range rec.Result().Cookies() {
		req.AddCookie(cookie)
	}
	rec = httptest.NewRecorder()
	ctx := webtest.NewContext(req, rec, "/", nil)
	if err := controller.Dashboard(ctx); err != nil {
		t.Fatalf("dashboard: %v", err)
	}
	if rec.Code != http.StatusOK {
		t.Fatalf("dashboard status = %d, want %d", rec.Code, http.StatusOK)
	}
	body := rec.Body.String()
	if !strings.Contains(body, "Dashboard") || !strings.Contains(body, "Admin User") {
		t.Fatalf("dashboard missing authenticated content:\n%s", body)
	}
}
