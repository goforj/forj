{{- if and .Components.Auth .Components.HasDatabase }}
func TestStarterUIUnauthenticatedPageRedirectsToLogin(t *testing.T) {
	fixture := newStarterUITestAuthFixture(t)
	controller := NewController(fixture.Service)
	req := httptest.NewRequest(http.MethodGet, "/", nil)
	rec := httptest.NewRecorder()
	ctx := webtest.NewContext(req, rec, "/", nil)

	if err := controller.Dashboard(ctx); err != nil {
		t.Fatalf("dashboard: %v", err)
	}
	if rec.Code != http.StatusSeeOther {
		t.Fatalf("status = %d, want %d; body:\n%s", rec.Code, http.StatusSeeOther, rec.Body.String())
	}
	if location := rec.Header().Get("Location"); location != "/login" {
		t.Fatalf("redirect = %q, want /login", location)
	}
	if strings.Contains(rec.Body.String(), `"error":"unauthorized"`) {
		t.Fatalf("page rendered JSON unauthorized response:\n%s", rec.Body.String())
	}
}

