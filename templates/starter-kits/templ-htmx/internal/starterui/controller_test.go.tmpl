func TestStarterUILoginPageRenders(t *testing.T) {
	controller := NewController(
{{- if and .Components.Auth .Components.HasDatabase }}
		nil,
{{- end }}
	)
	req := httptest.NewRequest(http.MethodGet, "/login", nil)
	rec := httptest.NewRecorder()
	ctx := webtest.NewContext(req, rec, "/login", nil)

	if err := controller.LoginPage(ctx); err != nil {
		t.Fatalf("render login page: %v", err)
	}
	if rec.Code != http.StatusOK {
		t.Fatalf("status = %d, want %d", rec.Code, http.StatusOK)
	}
	if body := rec.Body.String(); !strings.Contains(body, "Sign in") || !strings.Contains(body, "GoForj") {
		t.Fatalf("login page missing expected content:\n%s", body)
	}
}

