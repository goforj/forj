package starterui

import (
	"strings"
{{- if and .Components.Auth .Components.HasDatabase }}

	"{{.GoModuleName}}/internal/auth"
{{- end }}
)

// PageData is shared by starter UI pages.
type PageData struct {
	Title string
	User  UserData
}

// UserData is the display-safe user shape for starter UI pages.
type UserData struct {
	Name  string
	Email string
}

// LoginPageData is the data rendered by the login page.
type LoginPageData struct {
	Login string
	Error string
}

func activeClass(active bool) string {
	if active {
		return "active"
	}
	return ""
}

func fallbackUserData() UserData {
	return UserData{Name: "GoForj user", Email: "local app"}
}

func userInitials(name string) string {
	parts := strings.Fields(name)
	if len(parts) >= 2 {
		return strings.ToUpper(parts[0][:1] + parts[1][:1])
	}
	if len(parts) == 1 {
		if len(parts[0]) >= 2 {
			return strings.ToUpper(parts[0][:2])
		}
		return strings.ToUpper(parts[0])
	}
	return "GF"
}

// statusVariant keeps status semantics independent from Basecoat's canonical badge class.
func statusVariant(status string) string {
	switch status {
	case "Blocked", "Overdue", "Unauthorized":
		return "destructive"
	case "Draft", "Pending", "Queued", "Tomorrow":
		return "secondary"
	default:
		return "primary"
	}
}

func statusKey(status string) string {
	return strings.ToLower(status)
}

func componentsActive(title string) bool {
	return len(title) >= len("Components") && title[:len("Components")] == "Components"
}

{{- if and .Components.Auth .Components.HasDatabase }}
// UserFromAuth converts an auth user into display data.
func UserFromAuth(user *auth.User) UserData {
	if user == nil {
		return UserData{Name: "Signed out", Email: "No active session"}
	}
	name := user.DisplayName
	if name == "" {
		name = user.Username
	}
	return UserData{Name: name, Email: user.Email}
}
{{- else }}
// UserFromAuth returns placeholder display data when auth is not enabled.
func UserFromAuth() UserData {
	return UserData{Name: "GoForj user", Email: "local app"}
}
{{- end }}
