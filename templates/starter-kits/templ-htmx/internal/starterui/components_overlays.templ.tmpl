package starterui

templ OverlaysPage(data PageData) {
		@shell(data) {
			<div class="page-stack">
				@hero("Components", "Overlays", "Dialogs, drawers, and command patterns", "Overlay primitives are most useful when they are shown as real workflows: invite dialogs, destructive confirms, drawers, inspectors, and command-driven actions.")
				<div class="overlay-stack">
					<div class="grid grid-2">
						<section class="card">
							<div class="card-header">
								<h2>Modal workflows</h2>
								<p>Dialogs, sheets, and drawers are easier to judge when they look like product workflows rather than isolated mechanics.</p>
							</div>
							<div class="card-content">
								<div class="card-actions">
									<button class="btn" data-variant="primary" type="button" data-gf-open-dialog="invite-dialog">Open invite dialog</button>
									<button class="btn" data-variant="destructive" type="button" data-gf-open-dialog="archive-dialog">Archive project</button>
								</div>
								<div class="card-actions">
									<button class="btn" data-variant="outline" type="button" data-gf-open-dialog="inspector-sheet">Open side sheet</button>
									<button class="btn" data-variant="outline" type="button" data-gf-open-dialog="mobile-drawer">Open mobile drawer</button>
								</div>
							</div>
						</section>
						<section class="card">
							<div class="card-header">
								<h2>Command and notification patterns</h2>
								<p>Command palette and toast feedback round out the overlay patterns users expect in an admin shell.</p>
							</div>
							<div class="card-content">
								<div class="demo-card">
									<strong>Command palette</strong>
									<p>This uses the same command primitives that power the shell-level shortcut.</p>
									<div class="card-actions"><button class="btn" data-variant="primary" type="button" data-gf-open-dialog="gf-command-menu">Open command menu</button></div>
								</div>
								<div class="demo-card">
									<strong>Toast feedback</strong>
									<p>Toasts are useful for non-blocking confirmation after save, sync, or authentication actions.</p>
									<div class="card-actions"><button class="btn" data-variant="outline" type="button" data-gf-toast="success" data-gf-toast-title="Starter preview saved" data-gf-toast-description="This toast is rendered by the local templ starter controller.">Show success toast</button><button class="btn" data-variant="outline" type="button" data-gf-toast="info" data-gf-toast-title="Signed out" data-gf-toast-description="Non-blocking notifications are ready for auth and settings flows.">Show signed-out toast</button></div>
								</div>
							</div>
						</section>
					</div>
					<section class="card">
						<h2>Popover details, tooltips, and row actions</h2>
						<div class="preview-grid">
							<div class="popover" id="starter-api-popover">
								<button id="starter-api-popover-trigger" type="button" class="btn" data-variant="outline" aria-expanded="false" aria-controls="starter-api-popover-content">Production API</button>
								<div id="starter-api-popover-content" data-popover aria-hidden="true" class="w-80">
									<div class="grid gap-4">
										<header class="grid gap-1.5"><h3 class="leading-none font-medium">Production API</h3><p class="text-muted-foreground text-sm">Healthy, 128 requests in the last hour, p95 latency under 80ms.</p></header>
										<form class="form grid gap-2"><label class="field"><span>Alert threshold</span><input type="text" value="250ms" autofocus/></label></form>
									</div>
								</div>
							</div>
							<div class="demo-card"><strong>Tooltip syntax</strong><p>Tooltips are attached with data attributes.</p><button class="btn" data-variant="outline" type="button" data-tooltip="Inspect the deployment before promoting." data-side="bottom" data-align="start">Hover for tooltip</button></div>
							<div class="sheet-preview"><div>Deployment complete<span>now</span></div><div>Password updated<span>now</span></div><div>Queue worker restarted<span>now</span></div></div>
						</div>
					</section>
				</div>
				@overlayDialogs()
			</div>
		}
	}
templ overlayDialogs() {
		<dialog id="invite-dialog" class="dialog w-full sm:max-w-[425px]" aria-labelledby="invite-dialog-title" onclick="if (event.target === this) this.close()">
			<div>
				<header>
					<h2 id="invite-dialog-title">Invite a teammate</h2>
					<p>Use the same field patterns inside dialogs that the rest of the app uses.</p>
				</header>
				<section>
					<form class="form grid gap-4">
						<label class="field"><span>Email address</span><input type="email" placeholder="person@example.com"/></label>
						<label class="field"><span>Role</span><select class="select"><option>Administrator</option><option>Editor</option><option>Viewer</option></select></label>
					</form>
				</section>
				<footer>
					<button class="btn" data-variant="outline" type="button" data-gf-close-dialog>Cancel</button>
					<button class="btn" data-variant="primary" type="button" data-gf-close-dialog data-gf-toast="success" data-gf-toast-title="Invite sent" data-gf-toast-description="The teammate invite flow is wired through the shared overlay controller.">Send invite</button>
				</footer>
				<button type="button" aria-label="Close dialog" data-gf-close-dialog>@iconClose()</button>
			</div>
		</dialog>
		<dialog id="archive-dialog" class="dialog w-full sm:max-w-[425px]" aria-labelledby="archive-dialog-title">
			<div>
				<header>
					<h2 id="archive-dialog-title">Archive this project?</h2>
					<p>Reserve alert dialogs for destructive actions rather than routine confirmations.</p>
				</header>
				<footer>
					<button class="btn" data-variant="outline" type="button" data-gf-close-dialog>Cancel</button>
					<button class="btn" data-variant="destructive" type="button" data-gf-close-dialog>Archive</button>
				</footer>
				<button type="button" aria-label="Close dialog" data-gf-close-dialog>@iconClose()</button>
			</div>
		</dialog>
		<dialog id="inspector-sheet" class="dialog w-full sm:max-w-3xl" aria-labelledby="inspector-sheet-title" onclick="if (event.target === this) this.close()">
			<div>
				<header>
					<h2 id="inspector-sheet-title">Inspector panel</h2>
					<p>Sheets work well for detail views and side-task editors that should not interrupt the main page flow.</p>
				</header>
				<section class="grid gap-4">
					<div class="grid grid-2"><div class="demo-card"><strong>Request latency</strong><p>Median 84ms over the last hour.</p></div><div class="demo-card"><strong>Error budget</strong><p>99.95% availability target remains healthy.</p></div></div>
					<div class="demo-card"><strong>Recent events</strong><div class="item-list">@activityItem("Release promoted", "Production rollout completed without errors.")@activityItem("Health check recovered", "A brief API spike resolved automatically after autoscaling.")@activityItem("Audit trail captured", "Configuration changes were recorded for the current deploy group.")</div></div>
				</section>
				<footer>
					<button class="btn" data-variant="primary" type="button">Open logs</button>
					<button class="btn" data-variant="outline" type="button">Restart worker</button>
					<button class="btn" data-variant="outline" type="button" data-gf-close-dialog>Close</button>
				</footer>
				<button type="button" aria-label="Close dialog" data-gf-close-dialog>@iconClose()</button>
			</div>
		</dialog>
		<dialog id="mobile-drawer" class="gf-drawer">
			<div class="dialog-panel">
				<div><h2>Mobile actions</h2><p class="muted">Drawers are often a better fit than centered modals for small-screen action clusters.</p></div>
				<div class="demo-card"><strong>Queued deployment</strong><p class="metric-value">Version 24</p><p>Promote now, inspect release notes, or dismiss this action sheet.</p></div>
				<div class="control-list"><button class="btn w-full" data-variant="primary" type="button">Create deployment</button><button class="btn w-full" data-variant="outline" type="button">View docs</button><button class="btn w-full" data-variant="outline" type="button">Review release notes</button></div>
				<div class="dialog-actions"><button class="btn" data-variant="outline" type="button" data-gf-close-dialog>Done</button></div>
			</div>
		</dialog>
	}
