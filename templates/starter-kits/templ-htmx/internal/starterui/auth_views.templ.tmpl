package starterui

templ authShell(title string, eyebrow string) {
	<!doctype html>
	<html lang="en">
		<head>
			@baseHead(title)
		</head>
			<body>
				<div class="login">
					<section class="login-main">
						<div class="auth-panel">
							<a class="auth-logo" href="/"><img src="/goforj-logo.png" alt="GoForj Starter Kit"/></a>
							{ children... }
						</div>
					</section>
				</div>
			</body>
	</html>
}
templ LoginPage(data LoginPageData) {
		@authShell("Sign in", "Server-authoritative sessions") {
				<form class="form" method="post" action="/login" hx-post="/login" hx-target="body">
					<div><h1>Log in to your account</h1><p>Enter your email and password below to log in</p></div>
					if data.Error != "" {
						<div class="error">{ data.Error }</div>
					}
					<label class="field"><span>Username or email</span><input name="login" type="text" value={ data.Login } autocomplete="username" placeholder="email@example.com"/></label>
					<div class="field">
						<span>Password</span>
						<div class="password-field">
							<input class="input" name="password" type="password" autocomplete="current-password" placeholder="Password"/>
							<button type="button">Show</button>
						</div>
						<a class="field-link" href="/forgot-password">Forgot password?</a>
					</div>
					<label class="label gap-3 font-normal text-muted-foreground"><input class="input" name="remember" type="checkbox"/> Remember me</label>
				<button class="btn w-full" data-variant="primary" type="submit">Log in</button>
				<div class="auth-signup">Don't have an account? <a href="/register">Sign up</a></div>
			</form>
		}
	}
templ RegisterPage(data LoginPageData) {
		@authShell("Create account", "Generated account flow") {
			<form class="form">
				<div><h1>Create your account</h1><p>Enter your details below to sign up</p></div>
				<label class="field"><span>Name</span><input type="text" autocomplete="name" placeholder="Full name"/></label>
				<label class="field"><span>Email address</span><input type="email" autocomplete="email" placeholder="email@example.com"/></label>
				<label class="field"><span>Password</span><input type="password" autocomplete="new-password" placeholder="Password"/></label>
				<label class="field"><span>Confirm password</span><input type="password" autocomplete="new-password" placeholder="Confirm password"/></label>
				<button class="btn w-full" data-variant="primary" type="button">Create account</button>
				<div class="auth-links"><a href="/login">Log in</a></div>
			</form>
		}
}
templ ForgotPasswordPage(data LoginPageData) {
		@authShell("Forgot password", "Password recovery") {
			<form class="form">
				<div><h1>Forgot password</h1><p>Enter your email to receive a password reset link</p></div>
				<label class="field"><span>Email address</span><input type="email" autocomplete="off" placeholder="email@example.com"/></label>
				<button class="btn w-full" data-variant="primary" type="button">Email password reset link</button>
				<div class="auth-links"><a href="/login">Back to sign in</a></div>
			</form>
		}
}
templ ResetPasswordPage(data LoginPageData) {
		@authShell("Reset password", "Credential recovery") {
			<form class="form">
				<div><h1>Reset password</h1><p>Please enter your new password below</p></div>
				<label class="field"><span>New password</span><input type="password" autocomplete="new-password" placeholder="New password"/></label>
				<label class="field"><span>Confirm new password</span><input type="password" autocomplete="new-password" placeholder="Confirm new password"/></label>
				<button class="btn w-full" data-variant="primary" type="button">Reset password</button>
			</form>
		}
}
templ VerifyEmailPage(data LoginPageData) {
		@authShell("Verify email", "Email verification") {
			<section class="form">
				<div><h1>Verify email</h1><p>Confirm your email address to continue</p></div>
				<div class="info-panel"><strong>Verification status</strong><span class="muted">Open this route with a token to wire the real confirmation flow.</span></div>
				<a class="btn w-full" data-variant="primary" href="/login">Back to sign in</a>
			</section>
	}
}
