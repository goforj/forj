package starterui

templ ComponentsOverviewPage(data PageData) {
	@shell(data) {
		<div class="page-stack">
			@hero("Local component reference", "Organized by workflow", "Review the local templ library as a set of focused reference pages.", "The reference is split into focused routes so teams can review one category at a time and lift patterns from realistic examples instead of a single oversized catalog.")
			<section class="notice">
				<span>These pages focus on local, product-shaped examples. For the full templ documentation and Basecoat component reference, see <a href="https://templ.guide/" target="_blank" rel="noreferrer">templ.guide</a> and <a href="https://basecoatui.com/" target="_blank" rel="noreferrer">basecoatui.com</a>.</span>
				<a class="btn" data-variant="outline" href="https://templ.guide/">
					<span>Open docs</span>
					@iconArrowRight()
				</a>
			</section>
			<div class="grid grid-4">
					@componentCard("Forms", "/components/forms", "Validation, field wrappers, selects, tags, OTP, and staged setup flows.", "Vee-validate forms", "Combobox and selects", "Tags, OTP, and PIN inputs")
					@componentCard("Navigation", "/components/navigation", "Menus, disclosures, split panes, scroll containers, and content carousels.", "Menubar and dropdowns", "Context and popover menus", "Resizable and scrollable surfaces")
					@componentCard("Overlays", "/components/overlays", "Dialogs, sheets, drawers, command palette, and toast feedback patterns.", "Invite and destructive dialogs", "Sheet and drawer patterns", "Command and sonner usage")
					@componentCard("Data", "/components/data", "Tables, pagination, calendars, and scheduling-oriented reference screens.", "Admin-style tables", "Pagination primitives", "Single-date and range calendars")
			</div>
			@basecoatCoverage()
			<div class="section-stack">
				<div class="card">
					<h2>Surface primitives</h2>
					<p>Reusable primitives still need a small landing area so teams understand the shell and theme language at a glance.</p>
					<div class="badge-row"><span class="badge">Ready</span><span class="badge" data-variant="secondary">Queued</span><span class="badge" data-variant="outline">Draft</span><span class="badge" data-variant="destructive">Blocked</span></div>
					<div class="source-callout">
						<span class="source-callout-icon">@iconCircleCheckBig()</span>
						<div><strong>Everything here ships as local source</strong><p>The generated app owns these examples, so teams can adapt them directly instead of relying on a remote component catalog.</p></div>
					</div>
					<div class="media-tile">Product Hero Media</div>
					<div class="item-list">
						<div class="item-row">
							<span class="item-icon">@iconLayers3()</span>
							<div><strong>Application shell</strong><p>Sidebar, app header, auth bootstrap, and local UI source ship together as one coherent starting point.</p></div>
							<button class="btn" data-variant="secondary" type="button">Open</button>
						</div>
						<div class="item-row muted-row">
							<span class="item-icon">@iconSparkles()</span>
							<div><strong>Theme-aware by default</strong><p>Dark mode follows system preference and the light palette stays readable for day-to-day development.</p></div>
						</div>
					</div>
				</div>
					<div class="card">
						<h2>Loading and empty states</h2>
						<p>Keep a few cross-cutting primitives visible here, then move the deeper walkthroughs into the focused child pages.</p>
						<div class="badge-row">
							<span class="badge">@iconLoaderCircleSpin()<span>Syncing</span></span>
							<span class="badge" data-variant="secondary">@iconLoaderCircleSpin()<span>Updating</span></span>
							<span class="badge" data-variant="outline">@iconLoaderCircleSpin()<span>Loading</span></span>
						</div>
						<div class="skeleton">
							<span style="width:50%"></span><span style="width:72%"></span><span style="width:62%"></span>
							<p>@iconLoaderCircleSpin()<span>Loading primitives fit into any shell.</span></p>
						</div>
						<div class="empty-box">
							<div class="avatar-stack" aria-hidden="true"><img src="https://github.com/shadcn.png" alt=""/><img src="https://github.com/maxleiter.png" alt=""/><img src="https://github.com/evilrabbit.png" alt=""/></div>
							<strong>No team members added</strong>
							<p>Invite collaborators when the workspace is ready for shared development.</p>
							<button class="btn" data-variant="primary" type="button">@iconPlus()<span>Invite collaborators</span></button>
						</div>
						<div class="empty-box"><span class="empty-icon">@iconLoaderCircleSpin()</span><strong>Processing request</strong><p>Please wait while we process your request. Do not refresh the page.</p><button class="btn" data-variant="outline" type="button">Cancel</button></div>
					</div>
				</div>
			</div>
		}
	}
templ basecoatCoverage() {
	<section class="card">
		<h2>Basecoat component coverage</h2>
		<p>The starter kit tracks the local Basecoat catalog so generated examples stay aligned with the documented HTML contract.</p>
		<div class="grid grid-4">
			<div class="demo-card"><strong>Surfaces</strong><div class="component-token-list">@coverageToken("Accordion", "details.accordion")@coverageToken("Alert", ".alert")@coverageToken("Alert Dialog", "dialog.dialog")@coverageToken("Avatar", "img.rounded-full")@coverageToken("Badge", ".badge")@coverageToken("Breadcrumb", "ol")@coverageToken("Button", ".btn")@coverageToken("Button Group", ".button-group")@coverageToken("Card", ".card")@coverageToken("Dialog", "dialog.dialog")</div></div>
			<div class="demo-card"><strong>Forms</strong><div class="component-token-list">@coverageToken("Checkbox", "input.input")@coverageToken("Combobox", ".combobox")@coverageToken("Field", ".field")@coverageToken("Input", ".input")@coverageToken("Input Group", ".input-group")@coverageToken("Label", ".label")@coverageToken("Radio Group", "fieldset")@coverageToken("Select", ".select")@coverageToken("Slider", "input[type=range].input")@coverageToken("Switch", "role=switch")@coverageToken("Textarea", ".textarea")</div></div>
			<div class="demo-card"><strong>Navigation</strong><div class="component-token-list">@coverageToken("Command", ".command")@coverageToken("Dropdown Menu", ".dropdown-menu")@coverageToken("Pagination", "nav[aria-label]")@coverageToken("Popover", ".popover")@coverageToken("Sidebar", ".sidebar")@coverageToken("Tabs", ".tabs")@coverageToken("Theme Switcher", "data-gf-theme-option")@coverageToken("Toast", ".toaster/.toast")@coverageToken("Tooltip", "data-tooltip")</div></div>
			<div class="demo-card"><strong>Data States</strong><div class="component-token-list">@coverageToken("Carousel", ".slider")@coverageToken("Chart", "canvas")@coverageToken("Empty", "composed empty state")@coverageToken("Item", "article.group/item")@coverageToken("Kbd", ".kbd")@coverageToken("Progress", "progress bar")@coverageToken("Skeleton", "animate-pulse")@coverageToken("Spinner", "animate-spin")@coverageToken("Table", ".table")</div></div>
		</div>
	</section>
}
templ coverageToken(name string, selector string) {
	<span class="badge component-token" data-variant="outline"><span>{ name }</span><code>{ selector }</code></span>
}
templ componentCard(title string, href string, description string, first string, second string, third string) {
		<section class="card">
			<div class="title-row">@componentIcon(title)<h2>{ title }</h2></div>
			<p>{ description }</p>
			<ul class="muted-list">
				<li>{ first }</li>
				<li>{ second }</li>
				<li>{ third }</li>
			</ul>
			<form method="get" action={ href }>
				<button class="btn w-full" data-variant="primary" type="submit">
					<span>Open { title }</span>
					@iconArrowRight()
				</button>
			</form>
		</section>
	}
