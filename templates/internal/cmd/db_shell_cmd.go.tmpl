// ensureDBShellSQLitePath creates the runtime-equivalent parent for file-backed SQLite targets.
func ensureDBShellSQLitePath(dsn string) error {
	if dsn == "" || dsn == ":memory:" || dsn == "file::memory:" {
		return nil
	}
	path := dsn
	if strings.HasPrefix(path, "file:") {
		path = strings.TrimPrefix(path, "file:")
		if query := strings.Index(path, "?"); query != -1 {
			path = path[:query]
		}
	}
	directory := filepath.Dir(path)
	if directory == "." {
		return nil
	}
	return os.MkdirAll(directory, 0o755)
}

// parseDBShellMySQLDSN extracts the connection identity understood by the mysql client.
func parseDBShellMySQLDSN(raw string) (dbShellMySQLTarget, error) {
	dsn := strings.TrimSpace(raw)
	if dsn == "" {
		return dbShellMySQLTarget{}, fmt.Errorf("DSN is empty")
	}
	target := dbShellMySQLTarget{}
	slash := strings.LastIndex(dsn, "/")
	if slash < 0 {
		return dbShellMySQLTarget{}, fmt.Errorf("MySQL DSN must contain /database")
	}
	network := dsn[:slash]
	database := dsn[slash+1:]
	if at := strings.LastIndex(network, "@"); at >= 0 {
		credentials := network[:at]
		network = network[at+1:]
		target.Username, target.Password, _ = strings.Cut(credentials, ":")
	}
	if query := strings.Index(database, "?"); query >= 0 {
		args, err := dbShellMySQLQueryArgs(database[query+1:])
		if err != nil {
			return dbShellMySQLTarget{}, err
		}
		target.Args = args
		database = database[:query]
	}
	target.Database = database

	switch {
	case strings.HasPrefix(network, "tcp(") && strings.HasSuffix(network, ")"):
		address := network[len("tcp(") : len(network)-1]
		host, port, err := net.SplitHostPort(address)
		if err != nil {
			return dbShellMySQLTarget{}, fmt.Errorf("parse TCP address %q: %w", address, err)
		}
		target.Host = host
		target.Port = port
	case strings.HasPrefix(network, "unix(") && strings.HasSuffix(network, ")"):
		target.Socket = network[len("unix(") : len(network)-1]
	case network == "":
	default:
		return dbShellMySQLTarget{}, fmt.Errorf("unsupported MySQL DSN network shape")
	}

	if database, err := url.PathUnescape(target.Database); err == nil {
		target.Database = database
	}
	return target, nil
}

// dbShellMySQLQueryArgs preserves options with a portable client equivalent and rejects semantic drift.
func dbShellMySQLQueryArgs(rawQuery string) ([]string, error) {
	values, err := url.ParseQuery(rawQuery)
	if err != nil {
		return nil, fmt.Errorf("MySQL DSN query is malformed")
	}
	keys := make([]string, 0, len(values))
	for key := range values {
		keys = append(keys, key)
	}
	sort.Strings(keys)

	args := []string{}
	for _, key := range keys {
		options := values[key]
		if len(options) != 1 {
			return nil, fmt.Errorf("MySQL DSN option %q is repeated and cannot be translated safely", key)
		}
		value := options[0]
		switch key {
		case "charset":
			if strings.TrimSpace(value) == "" || strings.Contains(value, ",") {
				return nil, fmt.Errorf("MySQL DSN option %q cannot be translated safely", key)
			}
			args = append(args, "--default-character-set="+value)
		case "checkConnLiveness", "interpolateParams", "parseTime":
			if !dbShellMySQLBoolValue(value) {
				return nil, fmt.Errorf("MySQL DSN option %q has an invalid boolean value", key)
			}
		case "loc":
			if _, err := time.LoadLocation(value); err != nil {
				return nil, fmt.Errorf("MySQL DSN option %q has an invalid location", key)
			}
		case "timeTruncate":
			if _, err := time.ParseDuration(value); err != nil {
				return nil, fmt.Errorf("MySQL DSN option %q has an invalid duration", key)
			}
		case "time_zone":
			arg, err := dbShellMySQLTimeZoneArg(value)
			if err != nil {
				return nil, err
			}
			args = append(args, arg)
		case "tls":
			return nil, fmt.Errorf("MySQL DSN option %q cannot be translated safely across supported MySQL and MariaDB clients", key)
		default:
			return nil, fmt.Errorf("MySQL DSN option %q is not supported by db:shell; refusing to change connection semantics", key)
		}
	}
	return args, nil
}

// dbShellMySQLTimeZoneArg translates the generated fixed-offset session setting without allowing arbitrary init SQL.
func dbShellMySQLTimeZoneArg(value string) (string, error) {
	zone := strings.TrimSpace(value)
	if len(zone) >= 2 && zone[0] == '\'' && zone[len(zone)-1] == '\'' {
		zone = zone[1 : len(zone)-1]
	}
	if zone == "SYSTEM" {
		return "--init-command=SET SESSION time_zone='SYSTEM'", nil
	}
	if len(zone) != len("+00:00") || (zone[0] != '+' && zone[0] != '-') || zone[3] != ':' {
		return "", fmt.Errorf("MySQL DSN option %q cannot be translated safely", "time_zone")
	}
	hours, hoursErr := strconv.Atoi(zone[1:3])
	minutes, minutesErr := strconv.Atoi(zone[4:6])
	if hoursErr != nil || minutesErr != nil || hours > 14 || minutes > 59 || hours == 14 && minutes != 0 {
		return "", fmt.Errorf("MySQL DSN option %q cannot be translated safely", "time_zone")
	}
	return "--init-command=SET SESSION time_zone='" + zone + "'", nil
}

// dbShellMySQLBoolValue recognizes the boolean spellings accepted by the generated MySQL runtime.
func dbShellMySQLBoolValue(value string) bool {
	switch value {
	case "1", "true", "TRUE", "True", "0", "false", "FALSE", "False":
		return true
	default:
		return false
	}
}

// sanitizeDBShellPostgresDSN removes passwords from argv while retaining the selected DSN target.
func sanitizeDBShellPostgresDSN(raw string) (string, map[string]string, string, error) {
	dsn := strings.TrimSpace(raw)
	if dsn == "" {
		return "", nil, "", fmt.Errorf("DSN is empty")
	}

	isPostgresURL := strings.HasPrefix(dsn, "postgres://") || strings.HasPrefix(dsn, "postgresql://")
	parsed, err := url.Parse(dsn)
	if err != nil && isPostgresURL {
		return "", nil, "", fmt.Errorf("Postgres URL DSN is malformed")
	}
	if err == nil && isPostgresURL {
		query := parsed.Query()
		for _, key := range []string{"host", "hostaddr", "service", "port", "password", "sslpassword"} {
			if len(query[key]) > 1 {
				return "", nil, "", fmt.Errorf("Postgres URL DSN repeats %s", key)
			}
		}
		envVars := map[string]string{}
		if parsed.User != nil {
			username := parsed.User.Username()
			if password, ok := parsed.User.Password(); ok {
				envVars["PGPASSWORD"] = password
				parsed.User = url.User(username)
			}
		}
		for _, secret := range []struct {
			Key string
			Env string
		}{
			{Key: "password", Env: "PGPASSWORD"},
			{Key: "sslpassword", Env: "PGSSLPASSWORD"},
		} {
			if values, ok := query[secret.Key]; ok {
				envVars[secret.Env] = values[0]
				query.Del(secret.Key)
			}
		}
		parsed.RawQuery = query.Encode()
		host := parsed.Hostname()
		if value := query.Get("host"); value != "" {
			host = value
		}
		if value := query.Get("hostaddr"); value != "" {
			host = "hostaddr " + value
		} else if value := query.Get("service"); value != "" {
			host = "service " + value
		}
		return parsed.String(), envVars, host, nil
	}

	if strings.Contains(dsn, "://") || strings.HasPrefix(dsn, "//") || err == nil && (parsed.Scheme != "" || parsed.Host != "") {
		return "", nil, "", fmt.Errorf("Postgres DSN must use a postgres:// or postgresql:// URL or keyword=value syntax")
	}
	if !strings.Contains(dsn, "=") {
		return "", nil, "", fmt.Errorf("Postgres DSN must use a postgres:// or postgresql:// URL or keyword=value syntax")
	}
	fields, err := parseDBShellPostgresFields(dsn)
	if err != nil {
		return "", nil, "", err
	}
	envVars := map[string]string{}
	host := ""
	hostaddrTarget := ""
	serviceTarget := ""
	kept := make([]string, 0, len(fields))
	for _, field := range fields {
		switch strings.ToLower(field.Key) {
		case "password":
			envVars["PGPASSWORD"] = field.Value
			continue
		case "sslpassword":
			envVars["PGSSLPASSWORD"] = field.Value
			continue
		case "host":
			host = field.Value
		case "hostaddr":
			hostaddrTarget = "hostaddr " + field.Value
		case "service":
			serviceTarget = "service " + field.Value
		}
		kept = append(kept, field.Key+"="+quoteDBShellPostgresValue(field.Value))
	}
	if hostaddrTarget != "" {
		host = hostaddrTarget
	} else if serviceTarget != "" {
		host = serviceTarget
	}
	return strings.Join(kept, " "), envVars, host, nil
}

// rewriteDBShellPostgresComposeDSN pins a validated local DSN to the database endpoint inside its own container.
func rewriteDBShellPostgresComposeDSN(dsn string) (string, error) {
	parsed, err := url.Parse(dsn)
	if err == nil && (parsed.Scheme == "postgres" || parsed.Scheme == "postgresql") {
		parsed.Host = net.JoinHostPort("127.0.0.1", "5432")
		query := parsed.Query()
		for _, key := range []string{"host", "hostaddr", "port", "service"} {
			query.Del(key)
		}
		parsed.RawQuery = query.Encode()
		return parsed.String(), nil
	}

	if !strings.Contains(dsn, "=") {
		return "", fmt.Errorf("cannot rewrite opaque DSN for docker compose")
	}
	fields, err := parseDBShellPostgresFields(dsn)
	if err != nil {
		return "", err
	}
	kept := make([]string, 0, len(fields)+2)
	for _, field := range fields {
		switch strings.ToLower(field.Key) {
		case "host", "hostaddr", "port", "service":
			continue
		}
		kept = append(kept, field.Key+"="+quoteDBShellPostgresValue(field.Value))
	}
	kept = append(kept, "host="+quoteDBShellPostgresValue("127.0.0.1"), "port="+quoteDBShellPostgresValue("5432"))
	return strings.Join(kept, " "), nil
}

// parseDBShellPostgresFields parses libpq keyword DSNs without invoking a shell.
func parseDBShellPostgresFields(dsn string) ([]dbShellPostgresField, error) {
	fields := []dbShellPostgresField{}
	for i := 0; i < len(dsn); {
		for i < len(dsn) && (dsn[i] == ' ' || dsn[i] == '\t' || dsn[i] == '\n' || dsn[i] == '\r') {
			i++
		}
		if i >= len(dsn) {
			break
		}
		keyStart := i
		for i < len(dsn) && dsn[i] != '=' && dsn[i] != ' ' && dsn[i] != '\t' && dsn[i] != '\n' && dsn[i] != '\r' {
			i++
		}
		key := dsn[keyStart:i]
		for i < len(dsn) && (dsn[i] == ' ' || dsn[i] == '\t') {
			i++
		}
		if key == "" || i >= len(dsn) || dsn[i] != '=' {
			return nil, fmt.Errorf("invalid Postgres DSN field at byte %d", keyStart)
		}
		i++
		for i < len(dsn) && (dsn[i] == ' ' || dsn[i] == '\t') {
			i++
		}

		value := strings.Builder{}
		quoted := i < len(dsn) && dsn[i] == '\''
		if quoted {
			i++
		}
		closed := !quoted
		for i < len(dsn) {
			if quoted && dsn[i] == '\'' {
				i++
				closed = true
				break
			}
			if !quoted && (dsn[i] == ' ' || dsn[i] == '\t' || dsn[i] == '\n' || dsn[i] == '\r') {
				break
			}
			if dsn[i] == '\\' && i+1 < len(dsn) {
				i++
			}
			value.WriteByte(dsn[i])
			i++
		}
		if !closed {
			return nil, fmt.Errorf("unterminated quoted Postgres DSN value at byte %d", keyStart)
		}
		fields = append(fields, dbShellPostgresField{Key: key, Value: value.String()})
	}
	return fields, nil
}

// quoteDBShellPostgresValue produces a libpq-safe keyword DSN value.
func quoteDBShellPostgresValue(value string) string {
	value = strings.ReplaceAll(value, "\\", "\\\\")
	value = strings.ReplaceAll(value, "'", "\\'")
	return "'" + value + "'"
}

// launchLabel describes the selected method without exposing client arguments or credentials.
func (c *DBShellCmd) launchLabel(launch dbShellLaunch) string {
	if launch.Method == "compose" {
		service := ""
		for i := 0; i < len(launch.Args); i++ {
			if launch.Args[i] == "-T" {
				continue
			}
			if launch.Args[i] == "-e" {
				i++
				continue
			}
			if i >= 2 {
				service = launch.Args[i]
				break
			}
		}
		if service != "" {
			return "docker compose service " + service
		}
		return "docker compose"
	}
	return "local " + launch.Command
}

// runDBShellLaunch attaches terminal streams and delegates signal policy to an injectable wait loop.
func runDBShellLaunch(launch dbShellLaunch) error {
	cmd := exec.Command(launch.Command, launch.Args...)
	cmd.Stdin = os.Stdin
	cmd.Stdout = os.Stdout
	cmd.Stderr = os.Stderr
	cmd.Env = dbShellProcessEnv(os.Environ(), launch.Env)
	if err := cmd.Start(); err != nil {
		return err
	}

	waitCh := make(chan error, 1)
	go func() {
		waitCh <- cmd.Wait()
	}()

	signals := make(chan os.Signal, 2)
	signal.Notify(signals, os.Interrupt, syscall.SIGTERM)
	defer signal.Stop(signals)
	return waitDBShellProcess(
		launch.Command,
		waitCh,
		signals,
		dbShellDelegatedInterruptNeedsForwarding(),
		cmd.Process.Signal,
	)
}

// waitDBShellProcess forwards at most one delegated interrupt while leaving direct terminal-group SIGINT untouched.
func waitDBShellProcess(
	command string,
	waitCh <-chan error,
	signals <-chan os.Signal,
	forwardInterrupt bool,
	signalProcess func(os.Signal) error,
) error {
	interruptForwarded := false
	for {
		select {
		case err := <-waitCh:
			if err == nil {
				return nil
			}
			return dbShellProcessError(command, err)
		case received := <-signals:
			if received == os.Interrupt {
				if !forwardInterrupt || interruptForwarded {
					continue
				}
				interruptForwarded = true
			}
			_ = signalProcess(received)
		}
	}
}

// dbShellDelegatedInterruptNeedsForwarding detects source delegation, whose wrapper signals only the App PID.
func dbShellDelegatedInterruptNeedsForwarding() bool {
	return strings.TrimSpace(os.Getenv("FORJ_COMMAND_PREFIX")) != ""
}

// dbShellProcessError preserves ordinary and signal-derived child status for the App boundary.
func dbShellProcessError(command string, err error) error {
	if err != nil {
		if exitErr, ok := err.(*exec.ExitError); ok {
			code := exitErr.ExitCode()
			if status, ok := exitErr.Sys().(syscall.WaitStatus); ok && status.Signaled() {
				code = 128 + int(status.Signal())
			}
			return &dbShellProcessExit{Command: command, Code: code}
		}
		return err
	}
	return nil
}

// dbShellProcessEnv replaces inherited values so stale credentials cannot win by position.
func dbShellProcessEnv(inherited []string, overrides map[string]string) []string {
	out := make([]string, 0, len(inherited)+len(overrides))
	for _, assignment := range inherited {
		key, _, _ := strings.Cut(assignment, "=")
		if _, replaced := overrides[key]; replaced {
			continue
		}
		out = append(out, assignment)
	}
	for _, key := range dbShellSortedEnvKeys(overrides) {
		out = append(out, key+"="+overrides[key])
	}
	return out
}

// dbShellSortedEnvKeys keeps argv and diagnostic output deterministic.
func dbShellSortedEnvKeys(values map[string]string) []string {
	keys := make([]string, 0, len(values))
	for key := range values {
		keys = append(keys, key)
	}
	sort.Strings(keys)
	return keys
}

// localClient maps a normalized database driver to its supported shell executable.
func (c dbShellConnection) localClient() string {
	switch c.Driver {
	case "mysql":
		return "mysql"
	case "postgres":
		return "psql"
	case "sqlite":
		return "sqlite3"
	default:
		return ""
	}
}

// composeClient maps generated services to the client executable provided by their container image.
func (c dbShellConnection) composeClient() string {
	switch c.Driver {
	case "mysql":
		return "mariadb"
	default:
		return c.localClient()
	}
}

// composeService maps network database drivers to generated service names.
func (c dbShellConnection) composeService() string {
	switch c.Driver {
	case "mysql":
		return "mysql"
	case "postgres":
		return "postgres"
	default:
		return ""
	}
}

// validateComposeTarget prevents fallback from changing the selected resource identity.
func (c dbShellConnection) validateComposeTarget(service string) error {
	host, err := c.composeTargetHost()
	if err != nil {
		return err
	}
	if dbShellComposeHostMatches(host, service) {
		return nil
	}
	return fmt.Errorf("database connection %s targets %s and is not mapped to docker compose service %s", c.Name, maskDBShellValue(host), service)
}

// composeTargetHost returns the effective host selected by DSN precedence.
func (c dbShellConnection) composeTargetHost() (string, error) {
	if strings.TrimSpace(c.DSN) == "" {
		return strings.TrimSpace(c.Host), nil
	}
	switch c.Driver {
	case "mysql":
		target, err := parseDBShellMySQLDSN(c.DSN)
		if err != nil {
			return "", fmt.Errorf("database connection %s has an unusable MySQL DSN: %w", c.Name, err)
		}
		if target.Socket != "" {
			return "unix socket " + target.Socket, nil
		}
		return target.Host, nil
	case "postgres":
		_, _, host, err := sanitizeDBShellPostgresDSN(c.DSN)
		if err != nil {
			return "", fmt.Errorf("database connection %s has an unusable Postgres DSN: %w", c.Name, err)
		}
		if strings.TrimSpace(host) == "" {
			return "opaque DSN target", nil
		}
		return host, nil
	default:
		return strings.TrimSpace(c.Host), nil
	}
}

// dbShellComposeHostMatches accepts only endpoints that resolve to the generated service itself.
func dbShellComposeHostMatches(host string, service string) bool {
	if strings.TrimSpace(host) == "" {
		return false
	}
	hosts := strings.Split(host, ",")
	for _, candidate := range hosts {
		candidate = strings.Trim(strings.ToLower(strings.TrimSpace(candidate)), "[]")
		if candidate == strings.ToLower(service) || candidate == "localhost" {
			continue
		}
		if ip := net.ParseIP(candidate); ip != nil && ip.IsLoopback() {
			continue
		}
		return false
	}
	return true
}

// sqlitePath mirrors the generated database runtime's DSN and path precedence.
func (c dbShellConnection) sqlitePath() string {
	if dsn := strings.TrimSpace(c.DSN); dsn != "" {
		return dsn
	}
	if database := strings.TrimSpace(c.SQLiteDatabase); database != "" {
		return database
	}
	if database := strings.TrimSpace(c.Database); database != "" {
		return database
	}
	name := strings.ToLower(strings.TrimSpace(c.RuntimeName))
	if name == "" {
		name = strings.ToLower(strings.TrimSpace(c.Name))
	}
	if name == "" || name == "default" {
		return filepath.Join("_data", "sqlite", "app.db")
	}
	return filepath.Join("_data", "sqlite", name+".db")
}

// summary returns a selector-safe connection description with DSN secrets masked.
func (c dbShellConnection) summary() string {
	if strings.TrimSpace(c.DSN) != "" {
		return maskDBShellValue(c.DSN)
	}
	switch c.Driver {
	case "mysql", "postgres":
		if c.Host != "" && c.Port != "" && c.Database != "" {
			return c.Host + ":" + c.Port + "/" + c.Database
		}
	case "sqlite":
		return c.sqlitePath()
	}
	return "-"
}

// dbShellShellableCount reports how many discovered connections have a supported client.
func dbShellShellableCount(connections []dbShellConnection) int {
	return len(dbShellShellableConnections(connections))
}

// dbShellShellableConnections filters connections that have a supported local client.
func dbShellShellableConnections(connections []dbShellConnection) []dbShellConnection {
	out := make([]dbShellConnection, 0, len(connections))
	for _, conn := range connections {
		if conn.localClient() != "" {
			out = append(out, conn)
		}
	}
	return out
}

// dbShellInteractive reports whether selectors can safely own both terminal streams.
func dbShellInteractive() bool {
	if !dbShellStdinInteractive() {
		return false
	}
	stdout, err := os.Stdout.Stat()
	return err == nil && stdout.Mode()&os.ModeCharDevice != 0
}

// dbShellStdinInteractive reports whether Compose may preserve its default TTY allocation.
func dbShellStdinInteractive() bool {
	stdin, err := os.Stdin.Stat()
	return err == nil && stdin.Mode()&os.ModeCharDevice != 0
}

// dbShellEnv mirrors raw child-presence fallback before normalizing non-secret values.
func dbShellEnv(name, suffix string) string {
	scope := env.WithPrefix("DB")
	if name == "" || name == "default" {
		value := scope.Get(suffix, "")
		if suffix == "PASSWORD" {
			return value
		}
		return strings.TrimSpace(value)
	}
	child := scope.Child(str.Of(name).Snake().ToUpper().String())
	value := child.Get(suffix, "")
	if suffix == "PASSWORD" {
		if value != "" {
			return value
		}
		return scope.Get(suffix, "")
	}
	if value != "" {
		return strings.TrimSpace(value)
	}
	return strings.TrimSpace(scope.Get(suffix, ""))
}

// dbShellEnvKey returns the concrete root or named environment variable used in diagnostics.
func dbShellEnvKey(name, suffix string) string {
	if name == "" || name == "default" {
		return "DB_" + suffix
	}
	return "DB_" + str.Of(name).Snake().ToUpper().String() + "_" + suffix
}

// normalizeDBShellConnectionName exposes one kebab selector while env scopes remain snake-cased.
func normalizeDBShellConnectionName(name string) string {
	value := str.Of(name).Trim().ToLower().Kebab().String()
	if value == "" {
		return "default"
	}
	return value
}

// dbShellCheckDockerCompose verifies the Compose plugin before taking over the terminal.
func dbShellCheckDockerCompose() error {
	if _, err := exec.LookPath("docker"); err != nil {
		return fmt.Errorf("docker client not found: %w", err)
	}
	check := exec.Command("docker", "compose", "version")
	check.Stdout = io.Discard
	check.Stderr = io.Discard
	if err := check.Run(); err != nil {
		return fmt.Errorf("docker compose command is not available: %w", err)
	}
	return nil
}

// dbShellComposeServiceExists limits fallback to the generated Compose file in the App root.
func dbShellComposeServiceExists(service string) bool {
	if service == "" {
		return false
	}
	data, err := os.ReadFile("docker-compose.yml")
	if err != nil {
		return false
	}
	return dbShellComposeDefinesService(data, service)
}

// dbShellComposeDefinesService ignores same-named volumes and other nested YAML keys.
func dbShellComposeDefinesService(source []byte, service string) bool {
	inServices := false
	for _, line := range strings.Split(string(source), "\n") {
		trimmed := strings.TrimSpace(line)
		if trimmed == "" || strings.HasPrefix(trimmed, "#") {
			continue
		}
		indent := len(line) - len(strings.TrimLeft(line, " "))
		if indent == 0 {
			inServices = trimmed == "services:"
			continue
		}
		if inServices && indent == 2 && trimmed == service+":" {
			return true
		}
	}
	return false
}

// formatDBShellCommand renders diagnostics without allowing environment or argument secrets through.
func formatDBShellCommand(launch dbShellLaunch, mask bool) string {
	parts := []string{}
	for _, key := range dbShellSortedEnvKeys(launch.Env) {
		value := launch.Env[key]
		if mask && value != "" {
			value = "***"
		}
		parts = append(parts, key+"="+shellQuoteDBShell(value))
	}
	parts = append(parts, launch.Command)
	args := launch.Args
	if mask {
		args = maskDBShellArguments(launch.Command, args)
	}
	for _, arg := range args {
		parts = append(parts, shellQuoteDBShell(arg))
	}
	return strings.Join(parts, " ")
}

// shellQuoteDBShell renders one diagnostic argument without invoking a shell.
func shellQuoteDBShell(value string) string {
	if value == "" {
		return "''"
	}
	if strings.IndexFunc(value, func(r rune) bool {
		return !(r == '-' || r == '_' || r == '.' || r == '/' || r == ':' || r == '=' || r == '@' || r == ',' || r == '+' || r >= '0' && r <= '9' || r >= 'A' && r <= 'Z' || r >= 'a' && r <= 'z')
	}) == -1 {
		return value
	}
	return "'" + strings.ReplaceAll(value, "'", "'\"'\"'") + "'"
}

// maskDBShellArguments recognizes client flag forms in addition to standalone DSNs and assignments.
func maskDBShellArguments(command string, args []string) []string {
	mysqlClient := filepath.Base(command) == "mysql" || filepath.Base(command) == "mariadb"
	masked := make([]string, 0, len(args))
	for _, arg := range args {
		base := filepath.Base(arg)
		if base == "mysql" || base == "mariadb" {
			mysqlClient = true
		}
		masked = append(masked, maskDBShellClientArgument(arg, mysqlClient))
	}
	return masked
}

// maskDBShellClientArgument redacts compact MySQL passwords and secret-bearing long options.
func maskDBShellClientArgument(value string, mysqlClient bool) string {
	if mysqlClient && len(value) > 2 && strings.HasPrefix(value, "-p") && !strings.HasPrefix(value, "--") {
		return value[:2] + "***"
	}
	if name, raw, ok := strings.Cut(value, "="); ok && strings.HasPrefix(name, "--") {
		key := strings.TrimLeft(name, "-")
		if dbShellSecretKey(key) || key == "password1" || key == "password2" || key == "password3" {
			return name + "=***"
		}
		return name + "=" + maskDBShellValue(raw)
	}
	return maskDBShellValue(value)
}

// maskDBShellValue redacts secrets from valid and malformed connection strings.
func maskDBShellValue(value string) string {
	if value == "" {
		return value
	}
	if parsed, err := url.Parse(value); err == nil && parsed.Scheme != "" && parsed.Host != "" {
		changed := false
		if parsed.User != nil {
			if _, ok := parsed.User.Password(); ok {
				parsed.User = url.UserPassword(parsed.User.Username(), "***")
				changed = true
			}
		}
		query := parsed.Query()
		for key := range query {
			if dbShellSecretKey(key) {
				query.Set(key, "***")
				changed = true
			}
		}
		if changed {
			parsed.RawQuery = query.Encode()
			value = parsed.String()
		}
	}
	value = maskDBShellURLUserInfo(value)
	if at := strings.LastIndex(value, "@"); at > 0 {
		credentials := value[:at]
		target := value[at+1:]
		if (strings.HasPrefix(target, "tcp(") || strings.HasPrefix(target, "unix(") || strings.HasPrefix(target, "/")) && strings.Contains(credentials, ":") {
			username, _, _ := strings.Cut(credentials, ":")
			value = username + ":***@" + target
		}
	}
	return maskDBShellAssignments(value)
}

// maskDBShellURLUserInfo masks password-shaped URL authority text even when net/url rejects the URL.
func maskDBShellURLUserInfo(value string) string {
	scheme := strings.Index(value, "://")
	if scheme <= 0 {
		return value
	}
	authorityStart := scheme + len("://")
	authorityEnd := len(value)
	for _, delimiter := range []byte{'/', '?', '#'} {
		if relative := strings.IndexByte(value[authorityStart:], delimiter); relative >= 0 && authorityStart+relative < authorityEnd {
			authorityEnd = authorityStart + relative
		}
	}
	authority := value[authorityStart:authorityEnd]
	at := strings.LastIndex(authority, "@")
	if at < 0 {
		return value
	}
	credentials := authority[:at]
	colon := strings.Index(credentials, ":")
	if colon < 0 {
		return value
	}
	passwordStart := authorityStart + colon + 1
	atPosition := authorityStart + at
	return value[:passwordStart] + "***" + value[atPosition:]
}

// maskDBShellAssignments masks quoted and unquoted secret assignments in conninfo and client arguments.
func maskDBShellAssignments(value string) string {
	for _, key := range []string{"sslpassword", "password", "passwd", "pwd", "token", "secret", "auth"} {
		searchFrom := 0
		for {
			lower := strings.ToLower(value)
			relative := strings.Index(lower[searchFrom:], key+"=")
			if relative < 0 {
				break
			}
			index := searchFrom + relative
			if index > 0 && !dbShellSecretBoundary(value[index-1]) {
				searchFrom = index + len(key) + 1
				continue
			}
			start := index + len(key) + 1
			end := dbShellSecretValueEnd(value, start)
			if start < len(value) && (value[start] == '\'' || value[start] == '"') {
				quote := value[start : start+1]
				value = value[:start] + quote + "***" + quote + value[end:]
				searchFrom = start + len("'***'")
				continue
			}
			value = value[:start] + "***" + value[end:]
			searchFrom = start + 3
		}
	}
	return value
}

// dbShellSecretValueEnd finds the boundary of one assignment without exposing quoted tails.
func dbShellSecretValueEnd(value string, start int) int {
	if start >= len(value) {
		return start
	}
	if value[start] == '\'' || value[start] == '"' {
		quote := value[start]
		for i := start + 1; i < len(value); i++ {
			if value[i] == '\\' {
				i++
				continue
			}
			if value[i] == quote {
				return i + 1
			}
		}
		return len(value)
	}
	end := start
	for end < len(value) && value[end] != ' ' && value[end] != '\t' && value[end] != '\n' && value[end] != '\r' && value[end] != '&' && value[end] != ';' {
		end++
	}
	return end
}

// dbShellSecretBoundary reports whether an assignment key starts after a delimiter.
func dbShellSecretBoundary(value byte) bool {
	return !((value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') || value == '_')
}

// dbShellSecretKey identifies values that must never appear in diagnostic output.
func dbShellSecretKey(key string) bool {
	lower := strings.ToLower(strings.TrimSpace(key))
	return strings.Contains(lower, "password") || strings.Contains(lower, "passwd") || strings.Contains(lower, "pwd") || strings.Contains(lower, "token") || strings.Contains(lower, "secret") || strings.Contains(lower, "auth")
}
