// TestDBShellComposePreservesResourceIdentityAndSecrets verifies fallback cannot retarget or expose credentials in argv.
func TestDBShellComposePreservesResourceIdentityAndSecrets(t *testing.T) {
	root := t.TempDir()
	if err := os.WriteFile(filepath.Join(root, "docker-compose.yml"), []byte("services:\n  mysql:\n    image: mariadb\n"), 0o600); err != nil {
		t.Fatalf("write compose file: %v", err)
	}
	previous, err := os.Getwd()
	if err != nil {
		t.Fatalf("working directory: %v", err)
	}
	if err := os.Chdir(root); err != nil {
		t.Fatalf("change working directory: %v", err)
	}
	t.Cleanup(func() { _ = os.Chdir(previous) })

	command := &DBShellCmd{Method: "compose", Print: true}
	local := dbShellConnection{Name: "default", Driver: "mysql", Host: "mysql", Username: "user", Password: "secret", Database: "db"}
	launch, err := command.composeLaunch(local)
	if err != nil {
		t.Fatalf("compose launch: %v", err)
	}
	if launch.Env["MYSQL_PWD"] != "secret" || strings.Contains(strings.Join(launch.Args, " "), "secret") {
		t.Fatalf("compose secret transport = %#v, args %q", launch.Env, strings.Join(launch.Args, " "))
	}
	if !strings.Contains(strings.Join(launch.Args, " "), "mysql mariadb") {
		t.Fatalf("compose args = %q, want MariaDB container client", strings.Join(launch.Args, " "))
	}
	command.Exec = "select 1"
	scripted, err := command.composeLaunch(local)
	if err != nil {
		t.Fatalf("scripted compose launch: %v", err)
	}
	if !strings.Contains(strings.Join(scripted.Args, " "), "compose exec -T") {
		t.Fatalf("scripted compose args = %q, want non-TTY exec", strings.Join(scripted.Args, " "))
	}
	command.Exec = ""
	loopback := local
	loopback.Host = "127.42.0.1"
	if err := loopback.validateComposeTarget("mysql"); err != nil {
		t.Fatalf("loopback compose target: %v", err)
	}
	external := local
	external.Name = "reporting"
	external.Host = "db.example.com"
	if _, err := command.composeLaunch(external); err == nil || !strings.Contains(err.Error(), "not mapped") {
		t.Fatalf("external compose error = %v", err)
	}
	leakyHost := local
	leakyHost.Host = "postgres://user:host-secret@[bad/reports?password=query-secret"
	if err := leakyHost.validateComposeTarget("mysql"); err == nil {
		t.Fatal("secret-bearing malformed host was accepted for Compose")
	} else {
		for _, secret := range []string{"host-secret", "query-secret"} {
			if strings.Contains(err.Error(), secret) {
				t.Fatalf("compose target error %q retained %q", err, secret)
			}
		}
	}
	emptyHost := local
	emptyHost.Host = ""
	if err := emptyHost.validateComposeTarget("mysql"); err == nil || !strings.Contains(err.Error(), "not mapped") {
		t.Fatalf("empty host compose error = %v", err)
	}
	for _, dsn := range []string{
		"hostaddr=192.0.2.10 dbname=reports",
		"host=localhost hostaddr=127.0.0.1 dbname=reports",
		"service=production",
		"host=localhost service=production dbname=reports",
		"postgres://user@localhost/reports?host=db.example.com",
		"postgres://user@localhost/reports?hostaddr=192.0.2.10",
		"postgres://user@localhost/reports?service=production",
	} {
		opaque := local
		opaque.Driver = "postgres"
		opaque.DSN = dsn
		if err := opaque.validateComposeTarget("postgres"); err == nil || !strings.Contains(err.Error(), "not mapped") {
			t.Fatalf("opaque DSN %q compose error = %v", dsn, err)
		}
	}
}

// TestDBShellPostgresComposeChecksEveryMultiHost verifies one local fallback candidate cannot hide an external target.
func TestDBShellPostgresComposeChecksEveryMultiHost(t *testing.T) {
	accepted := []string{
		"host=postgres,localhost port=5432,5432 dbname=reports",
		"host=db.example.com host=postgres port=15432 port=5432 dbname=reports",
		"postgres://user@postgres,localhost/reports",
		"postgres://user@localhost/reports?host=postgres,127.0.0.1&port=5432,5432",
	}
	for _, dsn := range accepted {
		connection := dbShellConnection{Name: "default", Driver: "postgres", DSN: dsn}
		if err := connection.validateComposeTarget("postgres"); err != nil {
			t.Fatalf("local multi-host DSN %q was rejected: %v", dsn, err)
		}
	}

	rejected := []string{
		"host=postgres,db.example.com port=5432,5432 dbname=reports",
		"host=postgres host=db.example.com port=5432 dbname=reports",
		"postgres://user@postgres,db.example.com/reports",
		"postgres://user@localhost/reports?host=postgres,db.example.com&port=5432,5432",
	}
	for _, dsn := range rejected {
		connection := dbShellConnection{Name: "default", Driver: "postgres", DSN: dsn}
		if err := connection.validateComposeTarget("postgres"); err == nil || !strings.Contains(err.Error(), "not mapped") {
			t.Fatalf("external multi-host DSN %q compose error = %v", dsn, err)
		}
	}
}

