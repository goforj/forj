	}
	root := t.TempDir()
	if err := os.WriteFile(filepath.Join(root, "docker-compose.yml"), []byte("services:\n  mysql:\n    image: mariadb\n"), 0o600); err != nil {
		t.Fatalf("write compose file: %v", err)
	}
	bin := filepath.Join(root, "bin")
	if err := os.Mkdir(bin, 0o700); err != nil {
		t.Fatalf("make bin directory: %v", err)
	}
	docker := filepath.Join(bin, "docker")
	if err := os.WriteFile(docker, []byte("#!/bin/sh\nprintf '%s' \"$*\" > \"$DB_SHELL_DOCKER_LOG\"\nexit 23\n"), 0o700); err != nil {
		t.Fatalf("write fake docker: %v", err)
	}
	logPath := filepath.Join(root, "docker.log")
	t.Setenv("PATH", bin)
	t.Setenv("DB_SHELL_DOCKER_LOG", logPath)
	previous, err := os.Getwd()
	if err != nil {
		t.Fatalf("working directory: %v", err)
	}
	if err := os.Chdir(root); err != nil {
		t.Fatalf("change working directory: %v", err)
	}
	t.Cleanup(func() { _ = os.Chdir(previous) })

	command := &DBShellCmd{Method: "compose"}
	_, err = command.composeLaunch(dbShellConnection{Name: "default", Driver: "mysql", Host: "mysql", Username: "user", Database: "db"})
	if err == nil || !strings.Contains(err.Error(), "docker compose command is not available") {
		t.Fatalf("compose availability error = %v", err)
	}
	called, readErr := os.ReadFile(logPath)
	if readErr != nil {
		t.Fatalf("read fake docker log: %v", readErr)
	}
	if strings.TrimSpace(string(called)) != "compose version" {
		t.Fatalf("docker check args = %q, want compose version", called)
	}
}

// TestDBShellProcessErrorPreservesExactExitCode verifies the App boundary receives the native client status.
func TestDBShellProcessErrorPreservesExactExitCode(t *testing.T) {
	if runtime.GOOS == "windows" {
		t.Skip("requires POSIX shell exit and signal semantics")
	}
	for _, test := range []struct {
		name   string
		script string
		want   int
	}{
		{name: "exit", script: "exit 7", want: 7},
		{name: "signal", script: "kill -TERM $$", want: 143},
	} {
		t.Run(test.name, func(t *testing.T) {
			err := exec.Command("sh", "-c", test.script).Run()
			mapped := dbShellProcessError("client", err)
			var status interface{ ExitCode() int }
			if !errors.As(mapped, &status) || status.ExitCode() != test.want {
				t.Fatalf("mapped process error = %#v, want %d", mapped, test.want)
			}
		})
	}
}

// TestWaitDBShellProcessForwardsDelegatedInterruptOnce verifies PID delegation reaches the client without repeated delivery.
func TestWaitDBShellProcessForwardsDelegatedInterruptOnce(t *testing.T) {
	waitCh := make(chan error, 1)
	signals := make(chan os.Signal, 2)
	forwarded := make(chan os.Signal, 2)
	done := make(chan error, 1)
	go func() {
		done <- waitDBShellProcess("client", waitCh, signals, true, func(received os.Signal) error {
			forwarded <- received
			return nil
		})
	}()

	signals <- os.Interrupt
	select {
	case received := <-forwarded:
		if received != os.Interrupt {
			t.Fatalf("forwarded signal = %v", received)
		}
	case <-time.After(time.Second):
		t.Fatal("delegated interrupt was not forwarded")
	}
	signals <- os.Interrupt
	select {
	case received := <-forwarded:
		t.Fatalf("duplicate interrupt was forwarded: %v", received)
	case <-time.After(20 * time.Millisecond):
	}
	waitCh <- nil
	if err := <-done; err != nil {
		t.Fatalf("wait process: %v", err)
	}

	directWait := make(chan error, 1)
	directSignals := make(chan os.Signal, 2)
	directForwarded := make(chan os.Signal, 1)
	directDone := make(chan error, 1)
	go func() {
		directDone <- waitDBShellProcess("client", directWait, directSignals, false, func(received os.Signal) error {
			directForwarded <- received
			return nil
		})
	}()
	directSignals <- os.Interrupt
	directSignals <- syscall.SIGTERM
	select {
	case received := <-directForwarded:
		if received != syscall.SIGTERM {
			t.Fatalf("direct forwarded signal = %v, want SIGTERM", received)
		}
	case <-time.After(time.Second):
		t.Fatal("SIGTERM was not forwarded after direct terminal SIGINT")
	}
	directWait <- nil
	if err := <-directDone; err != nil {
		t.Fatalf("direct wait process: %v", err)
	}

	t.Setenv("FORJ_COMMAND_PREFIX", "forj")
	if !dbShellDelegatedInterruptNeedsForwarding() {
		t.Fatal("source delegation marker did not enable SIGINT forwarding")
	}
	t.Setenv("FORJ_COMMAND_PREFIX", "")
	if dbShellDelegatedInterruptNeedsForwarding() {
		t.Fatal("direct command unexpectedly enabled SIGINT forwarding")
	}
}

// TestDBShellProcessEnvReplacesCredentials verifies inherited secrets cannot override selected values.
func TestDBShellProcessEnvReplacesCredentials(t *testing.T) {
	got := dbShellProcessEnv([]string{"PATH=/bin", "PGPASSWORD=stale", "MYSQL_PWD=stale"}, map[string]string{"PGPASSWORD": "selected", "MYSQL_PWD": "mysql"})
	joined := strings.Join(got, "\n")
	if strings.Contains(joined, "stale") || strings.Count(joined, "PGPASSWORD=") != 1 || strings.Count(joined, "MYSQL_PWD=") != 1 {
		t.Fatalf("process env = %q", joined)
	}
	if !strings.HasSuffix(joined, "MYSQL_PWD=mysql\nPGPASSWORD=selected") {
		t.Fatalf("process env order = %q", joined)
	}
}

// TestMaskDBShellValueRedactsURLAndKeywordSecrets verifies selectors and print output cannot reveal DSN credentials.
func TestMaskDBShellValueRedactsURLAndKeywordSecrets(t *testing.T) {
	for _, value := range []string{
		"postgres://user:url-secret@host/db?sslpassword=query-secret",
		"host=db user=user password='quoted secret' dbname=app",
		"user:mysql-secret@tcp(mysql:3306)/db",
	} {
		masked := maskDBShellValue(value)
		for _, secret := range []string{"url-secret", "query-secret", "quoted secret", "mysql-secret"} {
			if strings.Contains(masked, secret) {
				t.Fatalf("masked value %q retained %q", masked, secret)
			}
		}
	}
}

// TestFormatDBShellCommandRedactsClientSecretFlags verifies passthrough client syntax cannot bypass print masking.
func TestFormatDBShellCommandRedactsClientSecretFlags(t *testing.T) {
	launches := []dbShellLaunch{
		{
			Command: "mysql",
			Args: []string{
				"-pcompact-secret",
				"--password=long-secret",
				"--password1=mfa-secret",
				"--dbname=postgres://user:url-secret@[bad/reports?password=query-secret",
			},
		},
		{Command: "docker", Args: []string{"compose", "exec", "mysql", "mariadb", "-pcompose-secret"}},
	}
	for _, launch := range launches {
		printed := formatDBShellCommand(launch, true)
		for _, secret := range []string{"compact-secret", "long-secret", "mfa-secret", "url-secret", "query-secret", "compose-secret"} {
			if strings.Contains(printed, secret) {
				t.Fatalf("masked command %q retained %q", printed, secret)
			}
		}
	}
}

// TestDBShellPostgresParseErrorsAndMalformedURLsStayRedacted verifies error and selection paths cannot echo malformed secrets.
func TestDBShellPostgresParseErrorsAndMalformedURLsStayRedacted(t *testing.T) {
	for _, dsn := range []string{
		"host=localhost broken password=conninfo-secret",
		"host=localhost password='unterminated-secret",
	} {
		_, _, _, err := sanitizeDBShellPostgresDSN(dsn)
		if err == nil {
			t.Fatalf("sanitize malformed DSN %q returned nil error", dsn)
		}
		for _, secret := range []string{"conninfo-secret", "unterminated-secret"} {
			if strings.Contains(err.Error(), secret) {
				t.Fatalf("sanitize error %q retained %q", err, secret)
			}
		}
	}
	malformedURL := "postgres://user:parse-secret@localhost/db%ZZ"
	_, _, _, err := sanitizeDBShellPostgresDSN(malformedURL)
	if err == nil || strings.Contains(err.Error(), "parse-secret") {
		t.Fatalf("malformed Postgres URL error = %v", err)
	}

	masked := maskDBShellValue("postgres://user:url-secret@[bad/reports?password=query-secret")
	for _, secret := range []string{"url-secret", "query-secret"} {
		if strings.Contains(masked, secret) {
			t.Fatalf("malformed URL mask %q retained %q", masked, secret)
		}
	}
}

// TestDBShellPostgresRejectsUnsupportedURLShapes verifies non-pgx URL forms cannot place credentials in psql argv.
func TestDBShellPostgresRejectsUnsupportedURLShapes(t *testing.T) {
	command := &DBShellCmd{}
	tests := []struct {
		dsn    string
		secret string
	}{
		{dsn: "https://user:https-secret@localhost/app", secret: "https-secret"},
		{dsn: "mysql://user:mysql-secret@localhost/app?sslmode=require", secret: "mysql-secret"},
		{dsn: "postgres:user:opaque-secret@localhost/app?sslmode=require", secret: "opaque-secret"},
		{dsn: "user:authority-secret@localhost/app", secret: "authority-secret"},
		{dsn: "POSTGRES://user:upper-secret@localhost/app", secret: "upper-secret"},
		{dsn: "//user:relative-secret@localhost/app?sslmode=require", secret: "relative-secret"},
	}
	for _, test := range tests {
		t.Run(test.secret, func(t *testing.T) {
			args, envVars, err := command.postgresArgs(dbShellConnection{Name: "default", Driver: "postgres", DSN: test.dsn}, false)
			if err == nil {
				t.Fatalf("postgres args accepted unsupported DSN shape: %q", strings.Join(args, " "))
			}
			if args != nil || envVars != nil {
				t.Fatalf("unsupported DSN returned args %q and env %#v", strings.Join(args, " "), envVars)
			}
			if strings.Contains(err.Error(), test.secret) {
				t.Fatalf("unsupported DSN error %q retained %q", err, test.secret)
			}
		})
	}
}
