// TestInheritedEnvironmentOverridesDotenv verifies launched App processes retain inherited values after dotenv loading.
func TestInheritedEnvironmentOverridesDotenv(t *testing.T) {
	if os.Getenv("GO_WANT_HOST_ENV_OVERRIDES_HELPER") == "1" {
		runHostEnvOverridesHelper()
		return
	}

	dir := t.TempDir()
	writeTestEnvFile(t, filepath.Join(dir, ".env"), "APP_ENV=local\nINHERITED_VALUE=from-dotenv\nDOTENV_ONLY=from-dotenv\nHOST_FALLBACK=from-base\n")
	writeTestEnvFile(t, filepath.Join(dir, ".env.production"), "PROFILE_MARKER=production\n")
	writeTestEnvFile(t, filepath.Join(dir, ".env.host"), "INHERITED_VALUE=from-host-fallback\nHOST_FALLBACK=from-host-fallback\n")
	output := runEnvDefaultsHelperProcess(t, "TestInheritedEnvironmentOverridesDotenv", dir, map[string]string{
		"APP_ENV":          "production",
		"INHERITED_VALUE": "from-process",
	})

	got := parseEnvDefaultsOutput(t, output)
	if got["APP_ENV"] != "production" || got["PROFILE_MARKER"] != "production" {
		t.Fatalf("inherited production profile = APP_ENV:%q marker:%q", got["APP_ENV"], got["PROFILE_MARKER"])
	}
	if got["INHERITED_VALUE"] != "from-process" {
		t.Fatalf("INHERITED_VALUE = %q, want inherited value", got["INHERITED_VALUE"])
	}
	if got["DOTENV_ONLY"] != "from-dotenv" {
		t.Fatalf("DOTENV_ONLY = %q, want dotenv value", got["DOTENV_ONLY"])
	}
	wantFallback := "from-base"
	if envpkg.IsHostEnvironment() || envpkg.IsDockerInDocker() {
		wantFallback = "from-host-fallback"
	}
	if got["HOST_FALLBACK"] != wantFallback {
		t.Fatalf("HOST_FALLBACK = %q, want %q", got["HOST_FALLBACK"], wantFallback)
	}
}

