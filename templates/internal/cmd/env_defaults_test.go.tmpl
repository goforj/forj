	}, "\n")+"\n")
	writeTestEnvFile(t, filepath.Join(dir, ".env.staging"), strings.Join([]string{
		"MARKER=staging",
		"BILLING_MARKER=app-staging",
	}, "\n")+"\n")

	output := runEnvDefaultsHelperProcess(t, "TestAppEnvOverlayCanSelectAppEnvFile", dir, map[string]string{
		"FORJ_APP":       "billing",
		"DB_URL":         "global",
