func TestAppLoggerSinkOrderAndIsolation(t *testing.T) {
	t.Setenv("APP_LOG_DEDUPE_ENABLED", "false")
	appLogger := logger.NewAppLogger()
	order := make([]string, 0, 2)
	appLogger.AddSink(func(entry logger.LogEntry) {
		order = append(order, "first")
		entry.Fields["mutated"] = true
		entry.Fields["nested"].(map[string]any)["mutated"] = true
	})
	appLogger.AddSink(func(entry logger.LogEntry) {
		order = append(order, "second")
		if _, ok := entry.Fields["mutated"]; ok {
			t.Fatal("expected each sink to receive an isolated entry")
		}
		if _, ok := entry.Fields["nested"].(map[string]any)["mutated"]; ok {
			t.Fatal("expected nested sink fields to be isolated")
		}
	})
	appLogger.Info().Str("token", "secret").Any("nested", map[string]any{"value": "safe"}).Msg("ordered")
	if strings.Join(order, ",") != "first,second" {
		t.Fatalf("expected registration order, got %#v", order)
	}
}

