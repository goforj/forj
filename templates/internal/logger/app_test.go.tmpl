func TestAppLoggerAsyncBlockingSinkFlushHonorsCancellationWhenQueueIsFull(t *testing.T) {
	t.Setenv("APP_LOG_DEDUPE_ENABLED", "false")
	appLogger := logger.NewAppLogger()
	sink := &stalledManagedSink{started: make(chan struct{}), release: make(chan struct{})}
	if err := appLogger.AddSinkWithOptions(sink, logger.SinkOptions{Async: true, QueueCapacity: 1, Overflow: logger.SinkOverflowBlock}); err != nil {
		t.Fatalf("add async sink: %v", err)
	}

	appLogger.Info().Msg("in-flight")
	select {
	case <-sink.started:
	case <-time.After(time.Second):
		t.Fatal("expected sink delivery to start")
	}
	appLogger.Info().Msg("queued")

	deliverDone := make(chan struct{})
	go func() {
		appLogger.Info().Msg("blocked")
		close(deliverDone)
	}()
	select {
	case <-deliverDone:
		t.Fatal("expected full blocking sink queue to block delivery")
	case <-time.After(50 * time.Millisecond):
	}

	ctx, cancel := context.WithCancel(context.Background())
	cancel()
	flushDone := make(chan error, 1)
	go func() {
		flushDone <- appLogger.FlushSinks(ctx)
	}()
	select {
	case err := <-flushDone:
		if !errors.Is(err, context.Canceled) {
			t.Fatalf("expected canceled flush, got %v", err)
		}
	case <-time.After(time.Second):
		t.Fatal("expected canceled flush to return")
	}
	select {
	case <-deliverDone:
	case <-time.After(time.Second):
		t.Fatal("expected blocked delivery to stop when sink closes")
	}

	deadlineCtx, deadlineCancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
	defer deadlineCancel()
	if err := appLogger.FlushSinks(deadlineCtx); !errors.Is(err, context.DeadlineExceeded) {
		t.Fatalf("expected deadline-exceeded flush, got %v", err)
	}

	close(sink.release)
	ctx, cancel = context.WithTimeout(context.Background(), time.Second)
	defer cancel()
	if err := appLogger.FlushSinks(ctx); err != nil {
		t.Fatalf("flush released sink: %v", err)
	}
}

func TestAppLoggerAsyncDropOldestSinkFlushesAfterConcurrentDelivery(t *testing.T) {
	t.Setenv("APP_LOG_DEDUPE_ENABLED", "false")
	appLogger := logger.NewAppLogger()
	sink := &stalledManagedSink{started: make(chan struct{}), release: make(chan struct{})}
	if err := appLogger.AddSinkWithOptions(sink, logger.SinkOptions{Async: true, QueueCapacity: 1, Overflow: logger.SinkOverflowDropOldest}); err != nil {
		t.Fatalf("add async sink: %v", err)
	}

	appLogger.Info().Msg("in-flight")
	select {
	case <-sink.started:
	case <-time.After(time.Second):
		t.Fatal("expected sink delivery to start")
	}

	var deliveries sync.WaitGroup
	for index := 0; index < 32; index++ {
		deliveries.Add(1)
		go func(index int) {
			defer deliveries.Done()
			appLogger.Info().Int("index", index).Msg("queued")
		}(index)
	}
	flushDone := make(chan error, 1)
	go func() {
		ctx, cancel := context.WithTimeout(context.Background(), 50*time.Millisecond)
		defer cancel()
		flushDone <- appLogger.FlushSinks(ctx)
	}()

	deliveriesDone := make(chan struct{})
	go func() {
		deliveries.Wait()
		close(deliveriesDone)
	}()
	select {
	case <-deliveriesDone:
	case <-time.After(time.Second):
		t.Fatal("expected concurrent drop-oldest deliveries to complete")
	}
	select {
	case err := <-flushDone:
		if !errors.Is(err, context.DeadlineExceeded) {
			t.Fatalf("expected deadline-exceeded flush, got %v", err)
		}
	case <-time.After(time.Second):
		t.Fatal("expected flush to honor its deadline")
	}

	close(sink.release)
	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
	defer cancel()
	if err := appLogger.FlushSinks(ctx); err != nil {
		t.Fatalf("flush released sink: %v", err)
	}
}

