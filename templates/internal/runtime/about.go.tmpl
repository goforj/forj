{{- if .ProjectComponents.Cache }}
	Caches      []AboutCache       `json:"caches,omitempty"`
{{- end }}
	Mails       []AboutMail        `json:"mails,omitempty"`
{{- if .ProjectComponents.Jobs }}
	Queues      []AboutQueue       `json:"queues,omitempty"`
{{- end }}
{{- if .ProjectComponents.Storage }}
	Storages    []AboutStorage     `json:"storages,omitempty"`
{{- end }}
{{- if .ProjectComponents.Events }}
	Events      []AboutEvent       `json:"events,omitempty"`
{{- end }}
	Sections    []AboutSectionData `json:"sections"`
}

